{{! Todos os pares da campanha (acesso já registrado em log): uma linha por par, anjo → protegido. }}
<div class="adm-cp">
  <header class="ed-topo">
    <a href="/admin/campanhas/{{campanha.id_campanha}}" class="ed-topo-btn" aria-label="Voltar para a campanha"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg></a>
    <h1 class="ed-titulo">Sorteio revelado</h1>
    <span></span>
  </header>
  <div class="adm-cp-corpo">
    <div class="adm-at alerta adm-cp-alerta">
      <span class="adm-at-ic" aria-hidden="true"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 9.9-1"/></svg></span>
      <span class="adm-at-txt">{{campanha.nome}} · {{pares.length}} par{{#unless (eq pares.length 1)}}es{{/unless}}. Este acesso foi registrado em log: não compartilhe a lista.</span>
    </div>
    <div class="adm-pares">
      {{#each pares}}
        <div class="adm-par">
          <div class="adm-par-p{{#unless this.anjo_ativo}} inativa{{/unless}}">
            <span class="adm-av" aria-hidden="true">{{#if this.anjo_foto}}<img src="{{this.anjo_foto}}" alt="" loading="lazy">{{else}}{{inicial this.anjo_nome}}{{/if}}</span>
            <span class="adm-par-txt"><strong>{{this.anjo_nome}}</strong><small>@{{this.anjo_usuario}}{{#unless this.anjo_ativo}} · inativo{{/unless}}</small></span>
          </div>
          <span class="adm-par-seta" aria-label="é anjo de"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
          <div class="adm-par-p{{#unless this.protegido_ativo}} inativa{{/unless}}">
            <span class="adm-av" aria-hidden="true">{{#if this.protegido_foto}}<img src="{{this.protegido_foto}}" alt="" loading="lazy">{{else}}{{inicial this.protegido_nome}}{{/if}}</span>
            <span class="adm-par-txt"><strong>{{this.protegido_nome}}</strong><small>@{{this.protegido_usuario}}{{#unless this.protegido_ativo}} · inativo{{/unless}}</small></span>
          </div>
        </div>
      {{else}}
        <div class="adm-vazio"><strong>Sem pares</strong></div>
      {{/each}}
    </div>
  </div>
</div>
