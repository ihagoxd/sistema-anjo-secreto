<div class="pagina-cabecalho">
  <div>
    <h1>Logs do sistema</h1>
    <p class="subtitulo">Últimas {{logs.length}} ações registradas (mais recentes primeiro).</p>
  </div>
  <a href="/admin" class="btn btn-secundario btn-sm">Voltar</a>
</div>

<div class="card">
  <ul class="atividade log-lista">
    {{#each logs}}
      <li class="atv-item">
        <span class="atv-dot"></span>
        <div class="atv-txt">
          <span class="atv-acao">{{rotuloAcao this.acao}}</span>
          {{#if this.nome_usuario}}<span class="atv-quem">{{this.nome_usuario}}</span>{{/if}}
          {{#if this.descricao}}<span class="log-det">{{this.descricao}}</span>{{/if}}
        </div>
        <span class="atv-tempo" title="{{formatarData this.criado_em}} · IP {{this.ip}}">{{tempoRel this.criado_em}}</span>
      </li>
    {{else}}
      <li class="atv-item"><span class="texto-suave">Nenhum log ainda.</span></li>
    {{/each}}
  </ul>
</div>
