<aside class="sidebar" id="sidebar">
  <a class="marca" href="{{#if (eq usuario.tipo_usuario "ADMINISTRADOR")}}/admin{{else}}/participante{{/if}}">
    <span class="marca-emblema" aria-hidden="true">
      <img src="/img/logo.png" alt="">
    </span>
    <span class="marca-wordmark">
      <span class="marca-nome">Anjo Secreto</span>
      <span class="marca-tag">Cuide em segredo</span>
    </span>
  </a>

  <nav class="side-nav">
    {{#if (eq usuario.tipo_usuario "ADMINISTRADOR")}}
      <span class="side-secao">Menu</span>
      <a href="/admin" class="side-link {{#if (eq caminhoAtual "/admin")}}ativo{{/if}}">
        <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/></svg>
        <span>Painel</span>
      </a>
      <a href="/admin/campanhas" class="side-link {{#if (comeca caminhoAtual "/admin/campanhas")}}ativo{{/if}}">
        <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
        <span>Campanhas</span>
      </a>
      <a href="/admin/usuarios" class="side-link {{#if (comeca caminhoAtual "/admin/usuarios")}}ativo{{/if}}">
        <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <span>Usuários</span>
      </a>
      <a href="/admin/aprovacoes" class="side-link {{#if (comeca caminhoAtual "/admin/aprovacoes")}}ativo{{/if}}">
        <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><polyline points="16 11 18 13 22 9"/></svg>
        <span>Aprovações</span>
      </a>
      <span class="side-secao">Gestão</span>
      <a href="/admin/avisos" class="side-link {{#if (comeca caminhoAtual "/admin/avisos")}}ativo{{/if}}">
        <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg>
        <span>Avisos</span>
      </a>
      <a href="/admin/logs" class="side-link {{#if (comeca caminhoAtual "/admin/logs")}}ativo{{/if}}">
        <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="16" y2="17"/></svg>
        <span>Logs</span>
      </a>
    {{else}}
      <span class="side-secao">Menu</span>
      <a href="/feed" class="side-link {{#if (ou (comeca caminhoAtual "/feed") (comeca caminhoAtual "/u/"))}}ativo{{/if}}">
        <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        <span>Mural</span>
      </a>
      <button type="button" class="side-link" data-busca-abrir>
        <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <span>Pesquisar</span>
      </button>
      <a href="/participante" class="side-link {{#if (eq caminhoAtual "/participante")}}ativo{{/if}}">
        <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/></svg>
        <span>Meu painel</span>
      </a>
      <a href="/mensagens" class="side-link {{#if (comeca caminhoAtual "/mensagens")}}ativo{{/if}}">
        <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
        <span>Mensagens</span>
        {{#if msgNaoLidas}}<span class="nav-badge js-msg-badge">{{msgNaoLidas}}</span>{{/if}}
      </a>
      <a href="/participante/preferencias" class="side-link {{#if (comeca caminhoAtual "/participante/preferencias")}}ativo{{/if}}">
        <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        <span>Preferências</span>
      </a>
    {{/if}}
  </nav>

  <div class="side-rodape">
    {{#unless (eq usuario.tipo_usuario "ADMINISTRADOR")}}
    <button type="button" class="side-link side-sino" data-abrir-modal="painelNotif" data-abrir-notif>
      <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
      <span>Notificações</span>
      {{#if notifNaoLidas}}<span class="nav-badge js-notif-badge">{{notifNaoLidas}}</span>{{/if}}
    </button>
    {{/unless}}
    <div class="side-tema">
      <span>Tema</span>
      <button type="button" class="btn-icone" id="btn-tema" aria-label="Alternar tema">
        <svg class="icon icone-lua" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg class="icon icone-sol" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
      </button>
    </div>
    <div class="side-user">
      {{#if (eq usuario.tipo_usuario "ADMINISTRADOR")}}
      <div class="side-user-info" style="cursor:default;">
        <span class="avatar">{{inicial usuario.nome}}</span>
        <div class="usuario-info"><strong>{{usuario.nome}}</strong><small>Administrador</small></div>
      </div>
      {{else}}
      <a class="side-user-info" href="/u/{{usuario.usuario}}" title="Ver meu perfil">
        <span class="avatar">{{#if usuario.foto_perfil}}<img src="{{usuario.foto_perfil}}" alt="">{{else}}{{inicial usuario.nome}}{{/if}}</span>
        <div class="usuario-info">
          <strong>{{usuario.nome}}</strong>
          <small>Participante</small>
        </div>
      </a>
      {{/if}}
      <form action="/logout" method="POST" class="logout-form">
        {{#if csrfToken}}<input type="hidden" name="_csrf" value="{{csrfToken}}">{{/if}}
        <button type="submit" class="btn-icone" title="Sair" aria-label="Sair">
          <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </button>
      </form>
    </div>
  </div>
</aside>
