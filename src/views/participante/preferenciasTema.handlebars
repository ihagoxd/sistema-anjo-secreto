<div class="ed pr pft-wrap"{{#if sucesso}} data-confete{{/if}}>
  <header class="ed-topo">
    <a href="/participante" class="ed-topo-btn" data-fluido-voltar aria-label="Voltar"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg></a>
    <h1 class="ed-titulo">Preferências do Anjo</h1>
    <button type="submit" form="formPrefsTema" class="ed-salvar" data-fluido-salvar disabled>Salvar</button>
  </header>

  <div class="pr-abas">{{> pfAbas abaAtiva="tema"}}</div>

  <div class="pft-hero">
    <div class="pft-hero-deco tb-deco" aria-hidden="true">
      {{#if (eq tema.chave "halloween")}}
      <i class="tb-bat" style="top:14%;--d:10s"><b></b></i><i class="tb-bat" style="top:30%;--d:13s;animation-delay:-6s"><b></b></i><span class="tb-neblina"></span>
      {{else if (eq tema.chave "natal")}}
      <i class="tb-floco" style="--x:3%;--d:5.0s;--t:3px;animation-delay:-0.0s"></i><i class="tb-floco" style="--x:13%;--d:6.3s;--t:4px;animation-delay:-1.7s"></i><i class="tb-floco" style="--x:22%;--d:7.6s;--t:5px;animation-delay:-3.4s"></i><i class="tb-floco" style="--x:32%;--d:8.9s;--t:3px;animation-delay:-5.1s"></i><i class="tb-floco" style="--x:42%;--d:5.0s;--t:4px;animation-delay:-0.8s"></i><i class="tb-floco" style="--x:52%;--d:6.3s;--t:5px;animation-delay:-2.5s"></i><i class="tb-floco" style="--x:61%;--d:7.6s;--t:3px;animation-delay:-4.2s"></i><i class="tb-floco" style="--x:71%;--d:8.9s;--t:4px;animation-delay:-5.9s"></i><i class="tb-floco" style="--x:81%;--d:5.0s;--t:5px;animation-delay:-1.6s"></i><i class="tb-floco" style="--x:90%;--d:6.3s;--t:3px;animation-delay:-3.3s"></i>
      {{else}}
      <span class="tb-balao" style="--c:#ff5a5f;left:4%;animation-delay:-2s"></span>
      <span class="tb-balao" style="--c:#4cc9f0;left:92%;animation-delay:-6s;transform:scale(.8)"></span>
      <i class="tb-confete" style="--c:#ffd166;left:20%;animation-delay:-1s"></i>
      <i class="tb-confete" style="--c:#06d6a0;left:50%;animation-delay:-3s"></i>
      <i class="tb-confete" style="--c:#8338ec;left:78%;animation-delay:-5s"></i>
      {{/if}}
    </div>
    <div class="pft-hero-emojis" aria-hidden="true">{{#if (eq tema.chave "halloween")}}<span>🎃</span><span>🍬</span><span>👻</span>{{else if (eq tema.chave "natal")}}<span>⛄</span><span>🎄</span><span>🎁</span>{{else}}<span>🧸</span><span>🎁</span><span>🍭</span>{{/if}}</div>
    <h2 class="pft-hero-tit">{{tema.prefs.heroTitulo}}</h2>
    <p class="pft-hero-txt">{{tema.prefs.heroTexto}}</p>
    {{#if (eq tema.chave "natal")}}{{! Natal: selo do Polo Norte no canto da carta e o carimbo "Enviada" (aparece se a cartinha já foi enviada e bate ao salvar) }}
    <span class="nt-selo" aria-hidden="true"><svg viewBox="0 0 58 68" width="58" height="68"><defs><linearGradient id="ntSeloCeu" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2f5fd0"/><stop offset="1" stop-color="#1d3f94"/></linearGradient></defs><rect width="58" height="68" fill="#fff"/><g fill="#fffaf0"><circle cx="3.0" cy="0" r="2.4"/><circle cx="3.0" cy="68" r="2.4"/><circle cx="9.5" cy="0" r="2.4"/><circle cx="9.5" cy="68" r="2.4"/><circle cx="16.0" cy="0" r="2.4"/><circle cx="16.0" cy="68" r="2.4"/><circle cx="22.5" cy="0" r="2.4"/><circle cx="22.5" cy="68" r="2.4"/><circle cx="29.0" cy="0" r="2.4"/><circle cx="29.0" cy="68" r="2.4"/><circle cx="35.5" cy="0" r="2.4"/><circle cx="35.5" cy="68" r="2.4"/><circle cx="42.0" cy="0" r="2.4"/><circle cx="42.0" cy="68" r="2.4"/><circle cx="48.5" cy="0" r="2.4"/><circle cx="48.5" cy="68" r="2.4"/><circle cx="55.0" cy="0" r="2.4"/><circle cx="55.0" cy="68" r="2.4"/><circle cx="0" cy="3.0" r="2.4"/><circle cx="58" cy="3.0" r="2.4"/><circle cx="0" cy="9.5" r="2.4"/><circle cx="58" cy="9.5" r="2.4"/><circle cx="0" cy="16.0" r="2.4"/><circle cx="58" cy="16.0" r="2.4"/><circle cx="0" cy="22.5" r="2.4"/><circle cx="58" cy="22.5" r="2.4"/><circle cx="0" cy="29.0" r="2.4"/><circle cx="58" cy="29.0" r="2.4"/><circle cx="0" cy="35.5" r="2.4"/><circle cx="58" cy="35.5" r="2.4"/><circle cx="0" cy="42.0" r="2.4"/><circle cx="58" cy="42.0" r="2.4"/><circle cx="0" cy="48.5" r="2.4"/><circle cx="58" cy="48.5" r="2.4"/><circle cx="0" cy="55.0" r="2.4"/><circle cx="58" cy="55.0" r="2.4"/><circle cx="0" cy="61.5" r="2.4"/><circle cx="58" cy="61.5" r="2.4"/></g><rect x="6" y="6" width="46" height="56" rx="2" fill="url(#ntSeloCeu)"/><circle cx="16" cy="18" r="1" fill="#fff"/><circle cx="42" cy="14" r="1.2" fill="#fff"/><circle cx="44" cy="30" r="0.9" fill="#fff"/><circle cx="13" cy="32" r="0.9" fill="#fff"/><path d="M29 15 L37 29 H33 L39 39 H19 L25 29 H21 Z" fill="#eaf2ff"/><rect x="27" y="39" width="4" height="5" fill="#eaf2ff"/><path d="M29 10.5 l1.3 2.6 2.9.4-2.1 2 .5 2.9-2.6-1.4-2.6 1.4.5-2.9-2.1-2 2.9-.4z" fill="#ffd36e"/><text x="29" y="54" text-anchor="middle" font-family="Inter, sans-serif" font-size="5.6" font-weight="800" letter-spacing=".6" fill="#fff">POLO NORTE</text><text x="9.5" y="13" font-family="Inter, sans-serif" font-size="6.5" font-weight="800" fill="#ffd36e">25</text></svg></span>
    <span class="nt-carimbo{{#if temaPrefsPreenchido}} visivel{{/if}}" aria-hidden="true" data-carimbo><svg viewBox="0 0 96 60" width="96" height="60" fill="none" stroke="#c8203a"><circle cx="30" cy="30" r="25" stroke-width="2.2"/><circle cx="30" cy="30" r="20" stroke-width="1"/><text x="30" y="27" text-anchor="middle" font-family="Inter, sans-serif" font-size="9.5" font-weight="900" fill="#c8203a" stroke="none" letter-spacing=".5">ENVIADA</text><text x="30" y="37" text-anchor="middle" font-family="Inter, sans-serif" font-size="5.6" font-weight="800" fill="#c8203a" stroke="none" letter-spacing=".6">POLO NORTE</text><path d="M58 20 q5 -4 10 0 t10 0 t10 0 M58 30 q5 -4 10 0 t10 0 t10 0 M58 40 q5 -4 10 0 t10 0 t10 0" stroke-width="2" stroke-linecap="round"/></svg></span>
    {{/if}}
  </div>

  <form id="formPrefsTema" class="form card pf-form pft-form" action="/participante/preferencias/tema" method="POST" novalidate data-fluido>
    <input type="hidden" name="_csrf" value="{{csrfToken}}">

    {{#each tema.prefs.campos}}
      {{#if (eq this.tipo "lista")}}
        <div class="campo campo-chips" data-chips data-max="{{this.max}}">
          <label for="chips-{{this.campo}}"><span class="lbl-ic">{{{this.icone}}}</span> {{this.rotulo}} <span class="chips-cont" data-chips-cont></span></label>
          {{#if this.dica}}<p class="pf-secao-dica">{{this.dica}}</p>{{/if}}
          <div class="chips" data-chips-box>
            <span class="chips-lista" data-chips-lista></span>
            <input type="text" id="chips-{{this.campo}}" data-chips-input data-placeholder="{{this.placeholder}}" placeholder="{{this.placeholder}}" maxlength="60" autocomplete="off" enterkeyhint="done">
          </div>
          <input type="hidden" name="{{this.campo}}" value="{{json (lookup @root.dados this.campo)}}">
          {{#if this.sugestoes}}
            <div class="chips-sug" data-chips-sug>
              <span class="chips-sug-rot">Ideias rápidas:</span>
              {{#each this.sugestoes}}<button type="button">{{this}}</button>{{/each}}
            </div>
          {{/if}}
        </div>
      {{else if (eq this.tipo "textarea")}}
        <div class="campo">
          <label for="pt-{{this.campo}}"><span class="lbl-ic">{{{this.icone}}}</span> {{this.rotulo}}</label>
          <textarea id="pt-{{this.campo}}" name="{{this.campo}}" rows="2" maxlength="500" placeholder="{{this.placeholder}}">{{lookup @root.dados this.campo}}</textarea>
        </div>
      {{else}}
        <div class="campo">
          <label for="pt-{{this.campo}}"><span class="lbl-ic">{{{this.icone}}}</span> {{this.rotulo}}</label>
          <input type="text" id="pt-{{this.campo}}" name="{{this.campo}}" maxlength="150" value="{{lookup @root.dados this.campo}}" placeholder="{{this.placeholder}}">
        </div>
      {{/if}}
    {{/each}}

    {{#if (eq tema.chave "natal")}}<p class="nt-carta-assina">Com carinho,<b>{{usuario.nome}}</b></p>{{/if}}
    <div class="pf-salvar">
      <button type="submit" class="btn btn-primario btn-bloco" data-fluido-salvar disabled>Salvar minha lista</button>
    </div>
  </form>

  <p class="pft-rodape texto-suave">Quem você tirou também preenche a lista dele(a) — você vê na página <a href="/participante/protegido">Seu protegido</a> quando o sorteio sair.</p>
</div>
