<div class="pagina-cabecalho">
  <div>
    <h1>Campanhas</h1>
    <p class="subtitulo">Cada mês tem sua rodada do Anjo Secreto.</p>
  </div>
  <a href="/admin" class="btn btn-secundario btn-sm">Voltar</a>
</div>

{{#if aberta}}
  <div class="card camp-mes">
    <div class="camp-mes-txt">
      <strong>🎁 {{aberta.nome}}</strong>
      <span class="texto-suave">{{#if (eq aberta.status "EM_ANDAMENTO")}}Em andamento — acompanhe a rodada.{{else}}Pronta para o sorteio.{{/if}}</span>
    </div>
    <a href="/admin/campanhas/{{aberta.id_campanha}}" class="btn btn-primario">Abrir campanha</a>
  </div>
{{else}}
  <form class="camp-mes card" action="/admin/campanhas" method="POST">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
    <div class="camp-mes-txt">
      <strong>🎁 Campanha do mês</strong>
      <span class="texto-suave">Nasce configurada como "{{sugestao}}" — dá para renomear depois.</span>
    </div>
    <button type="submit" class="btn btn-primario">Criar campanha do mês</button>
  </form>
{{/if}}

{{> tabelaCampanhas}}
