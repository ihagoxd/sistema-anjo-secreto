{{#if roleta}}
<div class="modal aniversario-modal roleta-modal" id="modalRoleta" hidden aria-hidden="true"
     data-camp="{{roleta.campId}}" data-alvo="{{roleta.nome}}">
  <span class="visualmente-oculto" data-roleta-nomes>{{roleta.nomes}}</span>
  <div class="modal-card aniv-card roleta-card">
    <div class="aniv-confete" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span><span></span>
      <span></span><span></span><span></span><span></span><span></span><span></span>
      <span></span><span></span><span></span><span></span><span></span><span></span>
    </div>

    {{! Fase 1 — girando os nomes }}
    <div class="roleta-palco" data-roleta-palco>
      <div class="roleta-selo" aria-hidden="true">🎁</div>
      <div class="roleta-label">Sorteando quem você tirou…</div>
      <div class="roleta-nome" data-roleta-display>?</div>
    </div>

    {{! Fase 2 — revelação }}
    <div class="roleta-reveal" data-roleta-resultado hidden>
      <button type="button" class="btn-icone aniv-fechar" data-fechar-modal="modalRoleta" aria-label="Fechar">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <div class="aniv-avatar">
        {{#if roleta.foto_perfil}}<img src="{{roleta.foto_perfil}}" alt="">{{else}}{{inicial roleta.nome}}{{/if}}
        <span class="aniv-bolo">🎁</span>
      </div>
      <h2 class="aniv-titulo">Você é o anjo de<br>{{roleta.nome}}! 🎉</h2>
      <p class="aniv-sub">Cuide dele(a) em segredo — {{roleta.nome}} nunca vai saber quem é o anjo.</p>
      <div class="aniv-acoes">
        <a class="btn btn-primario" href="/participante/protegido">Ver o que {{roleta.nome}} gosta</a>
        <button type="button" class="btn btn-secundario" data-fechar-modal="modalRoleta">Fechar</button>
      </div>
    </div>
  </div>
</div>
{{/if}}
