<div class="auth-form-cab">
  <span class="et">Acesso restrito</span>
  <h1>Entre na campanha</h1>
  <p>Veja seu protegido, suas preferências e as mensagens — tudo em sigilo.</p>
</div>

{{> authErro}}

{{! Entrar sem recarregar: se errar, o aviso aparece aqui mesmo e o que foi digitado fica }}
<form class="form" action="/login" method="POST" novalidate data-auth-form="login">
  {{#if csrfToken}}<input type="hidden" name="_csrf" value="{{csrfToken}}">{{/if}}

  <div class="campo">
    <label for="usuario">Usuário</label>
    <div class="auth-input">
      <svg class="auth-input-ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      <input type="text" id="usuario" name="usuario" autocomplete="username"
        placeholder="seu usuário" value="{{usuario}}" required
        autocapitalize="none" autocorrect="off" spellcheck="false" enterkeyhint="next" data-auth-login>
    </div>
  </div>

  {{> authSenha id="senha" rotulo="Senha" auto="current-password" tecla="go"}}

  <button type="submit" class="btn btn-primario btn-bloco" data-auth-enviar data-carregando="Entrando">Entrar</button>

  <p class="auth-troca">
    Ainda não tem acesso? <a href="/registrar">Criar conta</a>
  </p>
</form>
