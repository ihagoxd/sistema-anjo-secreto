<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <meta name="theme-color" content="#0d1117">
  <title>{{#if titulo}}{{titulo}} · {{/if}}Anjo Secreto</title>
  <link rel="icon" type="image/png" href="/img/logo.png">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png?v={{assetVer}}">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="apple-mobile-web-app-title" content="Anjo Secreto">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black">
  <meta name="csrf-token" content="{{csrfToken}}">
  <link rel="stylesheet" href="/css/estilo.css?v={{assetVer}}">
  <script nonce="{{cspNonce}}">
    (function () {
      try { document.documentElement.setAttribute('data-theme', localStorage.getItem('tema') || 'dark'); }
      catch (e) { document.documentElement.setAttribute('data-theme', 'dark'); }
      document.documentElement.classList.add('preparando');
      try { if (sessionStorage.getItem('anjoVisto')) document.documentElement.classList.add('mini'); } catch (e) {}
    })();
  </script>
</head>
<body class="{{#if pagina}}pg-{{pagina}}{{/if}}">
  {{> loader}}
  <div class="app">
    {{> sidebar}}

    <div class="conteudo">
      <header class="topo-mobile">
        <a class="topo-marca" href="{{#if (eq usuario.tipo_usuario "ADMINISTRADOR")}}/admin{{else}}/participante{{/if}}" aria-label="Início">
          <span class="marca-emblema" aria-hidden="true">
            <img src="/img/logo.png" alt="">
          </span>
        </a>
        <div class="topo-acoes">
          {{#if usuario}}{{#unless (eq usuario.tipo_usuario "ADMINISTRADOR")}}
          <button type="button" class="btn-icone btn-sino" data-abrir-modal="painelNotif" data-abrir-notif aria-label="Notificações">
            <svg class="icon" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
            {{#if notifNaoLidas}}<span class="sino-badge js-notif-badge">{{notifNaoLidas}}</span>{{/if}}
          </button>
          {{/unless}}{{/if}}
          <button type="button" class="btn-icone" id="btn-tema-mob" aria-label="Alternar tema">
            <svg class="icon icone-lua" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            <svg class="icon icone-sol" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
          </button>
          <form action="/logout" method="POST" class="logout-form">
            {{#if csrfToken}}<input type="hidden" name="_csrf" value="{{csrfToken}}">{{/if}}
            <button type="submit" class="btn-icone" title="Sair" aria-label="Sair">
              <svg class="icon" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            </button>
          </form>
        </div>
      </header>

      <main class="container">
        {{> alertas}}
        {{{body}}}
      </main>
    </div>

    {{> barraInferior}}
    {{! A busca vive DENTRO da .app: no mesmo contexto de empilhamento, a barra inferior
        (z 45) e a sidebar (z 50) ficam acima do painel de busca (z 40) — nada some }}
    {{#if usuario}}{{#unless (eq usuario.tipo_usuario "ADMINISTRADOR")}}{{> buscaTela}}{{/unless}}{{/if}}
  </div>

  {{#if usuario}}{{> painelNotificacoes}}{{/if}}
  {{#if avisosPendentes}}{{> avisoModal}}{{/if}}
  {{> roletaModal}}
  {{> aniversarioModal}}
  {{> cropper}}

  <script src="/js/ui.js?v={{assetVer}}" defer nonce="{{cspNonce}}"></script>
</body>
</html>
