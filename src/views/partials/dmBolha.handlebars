<div class="dm-bolha {{#if this.minha}}minha{{else}}deles{{/if}}{{#if this.imagem}} tem-img{{/if}}" data-id="{{this.id_mensagem}}">
  {{#if this.apagada}}
    <div class="dm-bolha-txt dm-apagada">🚫 Mensagem apagada</div>
  {{else}}
  {{#if this.quote}}
    {{! Citação (responder estilo WhatsApp): clica e rola até a mensagem original }}
    <div class="dm-cita" data-ir-msg="{{this.respondendo_a}}" role="button" tabindex="0" title="Ir para a mensagem original">
      <span class="dm-cita-autor">{{#if this.quote.minha}}Você{{else}}{{@root.conversa.rotuloResposta}}{{/if}}</span>
      <span class="dm-cita-texto">{{this.quote.texto}}</span>
    </div>
  {{/if}}
  {{#if this.storyPrev}}
    {{#if (eq this.storyPrev.tipo "mencao")}}
      {{! Menção no story: quem foi marcado vê a prévia + botão "Repostar esse story" }}
      <span class="dm-story-rotulo">{{#if this.minha}}🏷️ Você marcou {{@root.conversa.titulo}} no seu story{{else}}🏷️ Te marcou no story{{/if}}</span>
      <div class="dm-story-thumb{{#unless this.storyPrev.ativo}} expirado{{/unless}}"{{#if this.storyPrev.ativo}} data-abrir-story="{{this.storyPrev.id_autor}}" data-story-id="{{this.storyPrev.id_story}}" role="button" tabindex="0" title="Ver story"{{/if}}>
        {{#if this.imagem}}<img src="{{this.imagem}}" alt="" draggable="false">{{/if}}
        {{#if this.video}}<video src="{{this.video}}" preload="metadata" muted playsinline></video>{{/if}}
        {{#unless this.storyPrev.ativo}}<span class="dm-story-off">Story indisponível</span>{{/unless}}
      </div>
      {{#unless this.minha}}{{#if this.storyPrev.ativo}}
        <button type="button" class="btn btn-primario dm-repostar" data-repostar-story="{{this.storyPrev.id_story}}"{{#if this.imagem}} data-rps-img="{{this.imagem}}"{{/if}} data-rps-autor="{{this.storyPrev.usuario}}">Repostar esse story</button>
      {{/if}}{{/unless}}
    {{else}}
    {{#if (eq this.storyPrev.tipo "resposta")}}
      {{! Resposta de story, EXATAMENTE como o Instagram: rótulo discreto, a miniatura
          vertical do story (clicável enquanto ativo) e a mensagem como bolha normal abaixo }}
      <span class="dm-story-rotulo">{{#if this.minha}}Você respondeu ao story de {{@root.conversa.titulo}}{{else}}Respondeu ao seu story{{/if}}</span>
      <div class="dm-story-thumb{{#unless this.storyPrev.ativo}} expirado{{/unless}}"{{#if this.storyPrev.ativo}} data-abrir-story="{{this.storyPrev.id_autor}}" data-story-id="{{this.storyPrev.id_story}}" role="button" tabindex="0" title="Ver story"{{/if}}>
        {{#if this.imagem}}<img src="{{this.imagem}}" alt="" draggable="false">{{/if}}
        {{#if this.video}}<video src="{{this.video}}" preload="metadata" muted playsinline></video>{{/if}}
        {{#unless this.storyPrev.ativo}}<span class="dm-story-off">Story indisponível</span>{{/unless}}
      </div>
    {{else}}
      {{! Encaminhamento: cartão com rótulo + mídia + "Ver story" }}
      <div class="dm-storyprev{{#unless this.storyPrev.ativo}} expirado{{/unless}}"{{#if this.storyPrev.ativo}} data-abrir-story="{{this.storyPrev.id_autor}}" data-story-id="{{this.storyPrev.id_story}}" role="button" tabindex="0"{{/if}}>
        <span class="dm-storyprev-rotulo">📤 Story de <strong>@{{this.storyPrev.usuario}}</strong></span>
        {{#if this.imagem}}<img class="dm-storyprev-img" src="{{this.imagem}}" alt="" draggable="false">{{/if}}
        {{#if this.video}}<video class="dm-storyprev-img" src="{{this.video}}" preload="metadata" muted playsinline></video>{{/if}}
        <span class="dm-storyprev-hint">{{#if this.storyPrev.ativo}}Ver story ›{{else}}Story indisponível{{/if}}</span>
      </div>
    {{/if}}
    {{/if}}
  {{else}}
  {{#if this.imagem}}<div class="dm-bolha-img tw-post-midia" data-img="{{this.imagem}}" role="button" tabindex="0" aria-label="Ampliar imagem"><img src="{{this.imagem}}" alt="Foto" draggable="false"></div>{{/if}}
  {{#if this.video}}<div class="dm-bolha-video"><video src="{{this.video}}" controls playsinline preload="metadata"></video></div>{{/if}}
  {{/if}}
  {{#if this.audio}}
    <div class="dm-audio">
      <button type="button" class="dm-audio-play" data-audio-play aria-label="Ouvir mensagem de voz">
        <svg class="ic-play" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="6 3 21 12 6 21"/></svg>
        <svg class="ic-pause" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none"><rect x="5" y="4" width="5" height="16" rx="1"/><rect x="14" y="4" width="5" height="16" rx="1"/></svg>
      </button>
      <span class="dm-audio-trilha"><span class="dm-audio-prog"></span></span>
      <span class="dm-audio-tempo" data-audio-tempo>0:00</span>
      <button type="button" class="dm-audio-vel" data-audio-vel hidden aria-label="Velocidade">1x</button>
      <audio src="{{this.audio}}" preload="metadata"></audio>
    </div>
  {{/if}}
  {{#if this.postPrev}}
    <a class="dm-postprev" href="/p/{{this.postPrev.id_post}}">
      <span class="dm-postprev-cab">
        <span class="dm-postprev-av">{{#if this.postPrev.foto_perfil}}<img src="{{this.postPrev.foto_perfil}}" alt="">{{else}}{{inicial this.postPrev.nome}}{{/if}}</span>
        <span class="dm-postprev-user">{{this.postPrev.usuario}}</span>
      </span>
      {{#if this.postPrev.imagem}}<img class="dm-postprev-img" src="{{this.postPrev.imagem}}" alt="">{{/if}}
      {{#if this.postPrev.texto}}<span class="dm-postprev-txt">{{this.postPrev.texto}}</span>{{/if}}
      <span class="dm-postprev-ver">Ver publicação</span>
    </a>
    {{#if this.textoSemLink}}<div class="dm-bolha-txt">{{this.textoSemLink}}</div>{{/if}}
  {{else}}
    {{! No encaminhamento de story o rótulo já está no cartão — não repete o texto }}
    {{#if this.texto}}{{#unless (eq this.storyPrev.tipo "encaminhado")}}<div class="dm-bolha-txt">{{this.texto}}</div>{{/unless}}{{/if}}
  {{/if}}
  {{/if}}
  <div class="dm-bolha-meta">
    <span class="dm-hora">{{horaMsg this.criado_em}}</span>
    <span class="dm-editada"{{#unless this.editado_em}} hidden{{/unless}}>(editada)</span>
    {{#unless this.apagada}}
      <button type="button" class="dm-editar" data-responder-msg title="Responder" aria-label="Responder">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 17 4 12 9 7"/><path d="M20 18v-2a4 4 0 0 0-4-4H4"/></svg>
      </button>
    {{/unless}}
    {{#if this.minha}}{{#unless this.apagada}}
      {{#if this.texto}}<button type="button" class="dm-editar" data-editar-msg data-id="{{this.id_mensagem}}" data-escopo="{{@root.conversa.escopo}}" title="Editar mensagem" aria-label="Editar mensagem">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
      </button>{{/if}}
      <button type="button" class="dm-editar dm-apagar" data-apagar-msg data-id="{{this.id_mensagem}}" data-escopo="{{@root.conversa.escopo}}" title="Apagar para todos" aria-label="Apagar para todos">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
      </button>
    {{/unless}}{{/if}}
  </div>
</div>
