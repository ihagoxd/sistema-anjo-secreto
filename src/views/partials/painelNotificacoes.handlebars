<div class="modal notif-modal" id="painelNotif" hidden aria-hidden="true">
  <div class="modal-card notif-card">
    <div class="notif-cab">
      <button type="button" class="btn-icone notif-voltar" data-fechar-modal="painelNotif" aria-label="Voltar"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg></button>
      <h2>Notificações</h2>
      <div class="notif-cab-acoes">
        <button type="button" class="btn-icone" data-abrir-modal="notifPrefs" data-fechar-modal="painelNotif" aria-label="Preferências de notificação" title="Preferências">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        </button>
        <button type="button" class="btn-icone notif-fechar" data-fechar-modal="painelNotif" aria-label="Fechar">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
    </div>

    <nav class="notif-chips" data-notif-chips aria-label="Filtrar notificações">
      <button type="button" class="notif-chip ativo" data-filtro="todas">Todas</button>
      <button type="button" class="notif-chip" data-filtro="nao-lidas">Não lidas</button>
      <button type="button" class="notif-chip" data-filtro="mensagens">Mensagens</button>
      <button type="button" class="notif-chip" data-filtro="social">Feed</button>
      <button type="button" class="notif-chip" data-filtro="aniversario">Aniversários</button>
    </nav>

    <div class="notif-lista" data-notif-painel>
      <div class="notif-pane" data-filtro="todas">
        {{#each notifRecentes}}
          {{> notifItem this}}
        {{else}}
          <div class="notif-vazio"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg><div>Nenhuma notificação ainda.</div></div>
        {{/each}}
      </div>
    </div>
  </div>
</div>

{{> notifPrefs}}
