<div class="tw-perfil">
  <div class="tw-topbar">
    <a href="/feed" class="tw-back" aria-label="Voltar ao feed">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
    </a>
    <div class="tw-topbar-txt">
      <div class="tw-topbar-nome">{{alvo.nome}}</div>
      <div class="tw-topbar-count">{{numPublicacoes}} publicaç{{#if (eq numPublicacoes 1)}}ão{{else}}ões{{/if}}</div>
    </div>
    {{#if (eq alvo.id_usuario usuario.id_usuario)}}
    <button type="button" class="btn-icone tw-menu" data-abrir-modal="modal-perfil-menu" aria-label="Menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
    </button>
    {{/if}}
  </div>

  <div class="tw-banner"></div>

  <div class="tw-head">
    <div class="tw-avatar-row">
      <span class="tw-avatar{{#if alvo.temStory}} st-anel {{#if alvo.storyVisto}}st-visto{{else}}st-tem{{/if}}{{/if}}"
            data-avatar-perfil{{#if alvo.foto_perfil}} data-foto-ampla="{{alvo.foto_perfil}}"{{/if}}{{#if alvo.temStory}} data-ver-stories="{{alvo.id_usuario}}"{{/if}}
            {{#if alvo.temStory}}title="Toque: ver story · Segure: ampliar a foto"{{else}}{{#if alvo.foto_perfil}}title="Toque ou segure: ampliar a foto"{{/if}}{{/if}}>
        {{#if alvo.foto_perfil}}<img src="{{alvo.foto_perfil}}" alt="" draggable="false">{{else}}{{inicial alvo.nome}}{{/if}}
      </span>
      {{#if alvo.nota}}<span class="tw-nota" title="Nota de {{alvo.nome}}">{{alvo.nota}}</span>{{/if}}
      <div class="tw-acoes">
        {{#if (eq alvo.id_usuario usuario.id_usuario)}}
          <a href="/conta" class="btn btn-secundario">Editar perfil</a>
        {{else}}
          <a href="/mensagens/u/{{alvo.id_usuario}}" class="btn btn-primario">Mensagem</a>
        {{/if}}
      </div>
    </div>

    <div class="tw-nome">
      {{alvo.nome}}
      {{#if (eq alvo.tipo_usuario "ADMINISTRADOR")}}<span class="badge admin">Admin</span>{{/if}}
    </div>
    <div class="tw-user">@{{alvo.usuario}}</div>

    {{#if alvo.bio}}<div class="tw-bio">{{alvo.bio}}</div>{{/if}}

    <div class="tw-meta">
      {{#if alvo.data_nascimento}}
        <span class="tw-meta-item">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-8a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8"/><path d="M4 16s.5-1 2-1 2.5 2 4 2 2.5-2 4-2 2.5 2 4 2 2-1 2-1"/><path d="M2 21h20"/><path d="M7 8v3M12 8v3M17 8v3M7 4h.01M12 4h.01M17 4h.01"/></svg>
          Nasceu em {{diaMesExtenso alvo.data_nascimento}}
        </span>
      {{/if}}
      <span class="tw-meta-item">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        Entrou em {{mesAnoExtenso alvo.criado_em}}
      </span>
    </div>

    <div class="tw-stats">
      <span><strong>{{numPublicacoes}}</strong> Publicaç{{#if (eq numPublicacoes 1)}}ão{{else}}ões{{/if}}</span>
    </div>
  </div>

  <div class="tw-tabs">
    <a href="/u/{{alvo.usuario}}" class="tw-tab {{#if (eq aba "publicacoes")}}ativo{{/if}}">Publicações</a>
    <a href="/u/{{alvo.usuario}}/reposts" class="tw-tab {{#if (eq aba "reposts")}}ativo{{/if}}">Reposts</a>
    <a href="/u/{{alvo.usuario}}/gostos" class="tw-tab {{#if (eq aba "gostos")}}ativo{{/if}}">Gostos</a>
    {{#if (eq alvo.id_usuario usuario.id_usuario)}}<a href="/u/{{alvo.usuario}}/salvos" class="tw-tab {{#if (eq aba "salvos")}}ativo{{/if}}" title="Só você vê">Salvos</a>{{/if}}
  </div>

  <div class="tw-aba-conteudo" data-aba-conteudo>
    {{> perfilAba}}
  </div>
</div>

{{#if (eq alvo.id_usuario usuario.id_usuario)}}
{{! Menu do próprio perfil (como o ≡ do Instagram): conta, tema e sair }}
<div class="modal sheet-share" id="modal-perfil-menu" hidden aria-hidden="true">
  <div class="modal-card share-card comp-mais-card">
    <div class="sheet-cab sempre">
      <span class="sheet-grab" aria-hidden="true"></span>
      <span class="sheet-titulo">Menu</span>
      <button type="button" class="sheet-x" data-fechar-modal="modal-perfil-menu" aria-label="Fechar">&times;</button>
    </div>
    <div class="comp-mais-lista">
      <a class="comp-mais-op" href="/conta">
        <span class="comp-mais-ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></span>
        <span class="comp-mais-txt"><strong>Editar perfil</strong><small>Foto, nome, bio e dados</small></span>
      </a>
      <button type="button" class="comp-mais-op" data-abrir-modal="notifPrefs" data-fechar-modal="modal-perfil-menu">
        <span class="comp-mais-ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg></span>
        <span class="comp-mais-txt"><strong>Notificações</strong><small>O que avisar e como</small></span>
      </button>
      <button type="button" class="comp-mais-op" data-tema-toggle data-fechar-modal="modal-perfil-menu">
        <span class="comp-mais-ic"><svg class="icone-lua" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg><svg class="icone-sol" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg></span>
        <span class="comp-mais-txt"><strong>Tema</strong><small>Alternar entre claro e escuro</small></span>
      </button>
      <form action="/logout" method="POST" class="comp-mais-form">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <button type="submit" class="comp-mais-op comp-mais-sair">
          <span class="comp-mais-ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></span>
          <span class="comp-mais-txt"><strong>Sair</strong><small>Encerrar a sessão neste aparelho</small></span>
        </button>
      </form>
    </div>
  </div>
</div>
{{/if}}
