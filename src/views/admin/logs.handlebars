{{! Logs como lista de app: busca e filtro por ação respondem na hora (fetch), e a lista carrega
    mais sozinha ao chegar no fim, sem páginas. }}
<div class="adm" data-adm-logs>
  <header class="adm-cab">
    <div class="adm-cab-txt">
      <h1>Logs</h1>
      <small data-logs-total>{{total}} registro{{#unless (eq total 1)}}s{{/unless}}{{#if filtrando}} encontrado{{#unless (eq total 1)}}s{{/unless}}{{/if}}</small>
    </div>
  </header>

  <div class="direct-busca adm-busca">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <input type="search" value="{{q}}" placeholder="Quem fez, descrição ou IP" enterkeyhint="search" autocomplete="off" autocapitalize="none" spellcheck="false" aria-label="Pesquisar nos logs" data-logs-busca>
    <button type="button" class="direct-busca-x" data-logs-busca-x aria-label="Limpar"{{#unless q}} hidden{{/unless}}>&times;</button>
  </div>

  <nav class="adm-chips" aria-label="Filtrar por ação" data-logs-acoes>
    <a href="/admin/logs" class="chip{{#unless acao}} ativo{{/unless}}" data-logs-acao="">Tudo</a>
    {{#each acoes}}<a href="/admin/logs?acao={{this.acao}}" class="chip{{#if this.sel}} ativo{{/if}}" data-logs-acao="{{this.acao}}">{{rotuloAcao this.acao}} <span class="chip-n">{{this.n}}</span></a>{{/each}}
  </nav>

  <div class="pn-card adm-atv">
    <ul class="atividade log-lista" data-logs-lista>{{> admLogItens}}</ul>
  </div>
  <a class="adm-carregar" href="{{proxima}}" data-logs-mais{{#unless proxima}} hidden{{/unless}}>Carregar mais</a>
</div>
