<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <meta name="theme-color" content="#0c0f16">
  <title>{{#if titulo}}{{titulo}} · {{/if}}Anjo Secreto</title>
  <link rel="icon" type="image/png" href="/img/logo.png">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png?v={{assetVer}}">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="apple-mobile-web-app-title" content="Anjo Secreto">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black">
  <link rel="stylesheet" href="/css/estilo.css?v={{assetVer}}">
  <script nonce="{{cspNonce}}">
    (function () {
      try { document.documentElement.setAttribute('data-theme', localStorage.getItem('tema') || 'dark'); }
      catch (e) { document.documentElement.setAttribute('data-theme', 'dark'); }
      document.documentElement.classList.add('preparando');
      try { if (sessionStorage.getItem('anjoVisto')) document.documentElement.classList.add('mini'); } catch (e) {}
    })();
  </script>
</head>
<body>
  {{> loader}}

  <button type="button" class="btn-icone toggle-flutuante" id="btn-tema" aria-label="Alternar tema">
    <svg class="icon icone-lua" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    <svg class="icon icone-sol" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
  </button>

  <main class="auth-tela">
    <div class="auth-ceu" aria-hidden="true">
      <span style="left:8%;top:18%;animation-delay:.2s"></span>
      <span class="g" style="left:22%;top:62%;animation-delay:1.1s"></span>
      <span style="left:15%;top:40%;animation-delay:1.9s"></span>
      <span style="left:34%;top:24%;animation-delay:.7s"></span>
      <span style="left:30%;top:80%;animation-delay:1.4s"></span>
      <span class="g" style="left:46%;top:50%;animation-delay:2.2s"></span>
      <span style="left:52%;top:14%;animation-delay:.5s"></span>
      <span style="left:62%;top:34%;animation-delay:1.7s"></span>
      <span style="left:70%;top:72%;animation-delay:.9s"></span>
      <span class="g" style="left:84%;top:26%;animation-delay:1.3s"></span>
      <span style="left:90%;top:54%;animation-delay:.3s"></span>
      <span style="left:78%;top:88%;animation-delay:2s"></span>
      <span class="g" style="left:60%;top:90%;animation-delay:1.6s"></span>
      <span style="left:40%;top:64%;animation-delay:.6s"></span>
    </div>
    <div class="auth-molduras" aria-hidden="true"><span class="lt"></span><span class="rt"></span><span class="lb"></span><span class="rb"></span></div>

    <div class="auth-plate">
      <section class="auth-id">
        <div class="auth-kicker">
          <span class="fio"></span><span class="sinal">§</span>
          <span>Confidencial · MMXXVI</span>
          <span class="sinal">§</span><span class="fio"></span>
        </div>

        <svg class="auth-anjo" viewBox="0 0 176 200" fill="none" aria-hidden="true">
          <ellipse class="brilho" cx="88" cy="34" rx="25" ry="8.5" stroke="none"/>
          <ellipse class="l aur" cx="88" cy="34" rx="24" ry="8" pathLength="1"/>
          <path class="l asa-e" pathLength="1" d="M78 86 C50 74 28 84 18 110 C36 102 50 104 62 112 C44 108 38 122 40 140 C56 128 70 124 80 120"/>
          <path class="l asa-d" pathLength="1" d="M98 86 C126 74 148 84 158 110 C140 102 126 104 114 112 C132 108 138 122 136 140 C120 128 106 124 96 120"/>
          <path class="l corpo" pathLength="1" d="M76 76 C74 96 66 132 60 158 C72 166 104 166 116 158 C110 132 102 96 100 76"/>
          <circle class="l cabeca" cx="88" cy="62" r="13" pathLength="1"/>
        </svg>

        <div class="auth-wordmark">Anjo Secreto</div>
        <div class="auth-sub">Cuide em segredo</div>

        <div class="auth-losango"><span class="fio"></span><span class="d"></span><span class="fio"></span></div>
        <p class="auth-lema">Cada anjo zela, em silêncio, por quem lhe foi confiado.</p>
      </section>

      <section class="auth-form-wrap">
        {{> alertas}}
        {{{body}}}
      </section>
    </div>

    <div class="auth-colofao">Desenvolvido por
      <a class="auth-assina" href="https://instagram.com/ihagomartins1" target="_blank" rel="noopener noreferrer"
         aria-label="Instagram de Ihago Martins — @ihagomartins1">Ihago Martins</a>
    </div>
  </main>

  <script src="/js/ui.js?v={{assetVer}}" defer nonce="{{cspNonce}}"></script>
</body>
</html>
