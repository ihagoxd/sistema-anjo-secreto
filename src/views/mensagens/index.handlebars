<div class="direct {{#if conversa}}tem-conversa{{/if}}" data-me="{{usuario.id_usuario}}">

  <aside class="direct-lista">
    <div class="direct-lista-topo">
      <div><h1>Mensagens</h1><span class="direct-lista-sub">Direct do escritório</span></div>
      <button type="button" class="btn-icone direct-novo-grupo" data-abrir-modal="modal-novo-grupo" title="Novo grupo" aria-label="Novo grupo">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
      </button>
    </div>

    {{! Notas (estilo Instagram): balãozinho acima do avatar, "Sua nota" primeiro.
        Identidade pública do escritório — não toca nos canais secretos do jogo. }}
    <div class="notas">
      <button type="button" class="nota" data-abrir-modal="modal-nota" title="{{#if notaEu}}{{notaEu}} · alterar{{else}}Deixar uma nota{{/if}}">
        <span class="nota-bolha {{#unless notaEu}}vazia{{/unless}}">{{#if notaEu}}{{notaEu}}{{else}}+{{/if}}</span>
        <span class="nota-av{{#if tenhoStory}} st-anel st-tem{{/if}}">{{#if usuario.foto_perfil}}<img src="{{usuario.foto_perfil}}" alt="">{{else}}{{inicial usuario.nome}}{{/if}}</span>
        <span class="nota-nome">Sua nota</span>
      </button>
      {{#each notas}}
        <a class="nota" href="/mensagens/u/{{this.id_usuario}}" title="{{this.nome}} · {{this.nota}}">
          <span class="nota-bolha">{{this.nota}}</span>
          <span class="nota-av{{#if this.temStory}} st-anel {{#if this.storyVisto}}st-visto{{else}}st-tem{{/if}}{{/if}}"{{#if this.temStory}} data-ver-stories="{{this.id_usuario}}" title="Ver o story de {{this.nome}}"{{/if}}>{{#if this.foto_perfil}}<img src="{{this.foto_perfil}}" alt="">{{else}}{{inicial this.nome}}{{/if}}</span>
          <span class="nota-nome">{{this.usuario}}</span>
        </a>
      {{/each}}
    </div>

    <div class="direct-scroll">
      {{#if participaJogo}}
        <div class="direct-secao secao-secreta">
          <span>Anjo Secreto</span>
          <span class="secao-hint">anônimo · só você vê</span>
        </div>

        <a class="conv fixado conv-secreto {{#if (eq conversa.tipo "anjo")}}ativa{{/if}}{{#if unread.anjo}} tem-novas{{/if}}" href="/mensagens/anjo">
          <span class="conv-av anjo-av">😇</span>
          <div class="conv-txt">
            <div class="conv-nome">Seu anjo <span class="tag-secreto">anônimo</span></div>
            <div class="conv-sub">você não sabe quem é</div>
          </div>
          {{#if unread.anjo}}<span class="conv-badge">{{unread.anjo}}</span>{{/if}}
        </a>

        <a class="conv fixado conv-secreto sigilo {{#if (eq conversa.tipo "protegido")}}ativa{{/if}}{{#if unread.protegido}} tem-novas{{/if}}" href="/mensagens/protegido" data-sigilo>
          <span class="conv-av">
            <span class="sig-emoji" aria-hidden="true">👀</span>
            <span class="sig-foto">{{#if protegido.foto_perfil}}<img src="{{protegido.foto_perfil}}" alt="">{{else}}{{inicial protegido.nome}}{{/if}}</span>
            <span class="conv-mascara">🎭</span>
          </span>
          <div class="conv-txt">
            <div class="conv-nome"><span class="sig-generico">Seu protegido</span><span class="sig-real">{{protegido.nome}}</span></div>
            <div class="conv-sub">você é o anjo secreto dele(a)</div>
          </div>
          <span class="sigilo-olho" data-sigilo-toggle role="button" tabindex="0" aria-label="Mostrar ou ocultar quem é" title="Mostrar/ocultar quem é">
            <svg class="olho-ver" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
            <svg class="olho-ocultar" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
          </span>
          {{#if unread.protegido}}<span class="conv-badge">{{unread.protegido}}</span>{{/if}}
        </a>

        <div class="direct-secao">Escritório <span class="secao-hint">com o seu nome</span></div>
      {{else}}
        <div class="direct-secao">Escritório</div>
      {{/if}}

      {{#each lista}}
        {{#if this.ehGrupo}}{{> convGrupo}}{{else}}
        <a class="conv {{#if (eq @root.conversa.tipo "u")}}{{#if (eq @root.conversa.id this.id_usuario)}}ativa{{/if}}{{/if}}{{#if this.naoLidas}} tem-novas{{/if}}" href="/mensagens/u/{{this.id_usuario}}" data-conv-u="{{this.id_usuario}}">
          <span class="conv-av{{#if this.temStory}} st-anel {{#if this.storyVisto}}st-visto{{else}}st-tem{{/if}}{{/if}}"{{#if this.temStory}} data-ver-stories="{{this.id_usuario}}" title="Ver o story de {{this.nome}}"{{/if}}>{{#if this.foto_perfil}}<img src="{{this.foto_perfil}}" alt="">{{else}}{{inicial this.nome}}{{/if}}</span>
          <i class="online-dot" data-online-de="{{this.id_usuario}}"{{#unless this.online}} hidden{{/unless}} title="Ativo agora"></i>
          <div class="conv-txt">
            <div class="conv-nome">{{this.nome}}{{#if this.souProtegido}} <span class="tag-tirei">você tirou 🎁</span>{{/if}}</div>
            <div class="conv-sub">{{#if this.ultima}}{{#if this.ultima.minha}}Você: {{/if}}{{this.ultima.texto}}{{else}}@{{this.usuario}}{{/if}}</div>
          </div>
          {{#if this.naoLidas}}<span class="conv-badge">{{this.naoLidas}}</span>{{/if}}
        </a>
        {{/if}}
      {{else}}
        <div class="direct-vazio-lista">Ninguém aprovado por aqui ainda.</div>
      {{/each}}
    </div>
  </aside>

  <section class="direct-conversa {{#if conversa.secreto}}dm-secreto{{/if}}{{#if (eq conversa.tipo "protegido")}} sigilo{{/if}}"{{#if (eq conversa.tipo "protegido")}} data-sigilo{{/if}} data-conv-canal="{{conversa.tipo}}" data-conv-id="{{conversa.id}}"{{#if conversa.tema}} data-tema="{{conversa.tema}}"{{/if}}>
    {{#if conversa}}
      <header class="dm-cab">
        <a href="/mensagens" class="dm-voltar" aria-label="Voltar para a lista">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </a>
        <span class="conv-av {{#if conversa.anonimo}}anjo-av{{/if}}{{#if conversa.grupo}} grupo-av{{/if}}">
          {{#if conversa.grupo}}
            {{#if conversa.foto}}<img src="{{conversa.foto}}" alt="">{{else}}{{#each conversa.amostra}}<span class="grupo-av-m">{{#if this.foto}}<img src="{{this.foto}}" alt="">{{else}}{{inicial this.nome}}{{/if}}</span>{{else}}<span class="grupo-av-m">👥</span>{{/each}}{{/if}}
          {{else}}{{#if (eq conversa.tipo "protegido")}}
            <span class="sig-emoji" aria-hidden="true">👀</span>
            <span class="sig-foto">{{#if conversa.foto}}<img src="{{conversa.foto}}" alt="">{{else}}{{inicial conversa.titulo}}{{/if}}</span>
            <span class="conv-mascara">🎭</span>
          {{else}}
            {{#if conversa.anonimo}}😇{{else}}{{#if conversa.foto}}<img src="{{conversa.foto}}" alt="">{{else}}{{inicial conversa.titulo}}{{/if}}{{/if}}
          {{/if}}{{/if}}
        </span>
        <div class="dm-cab-txt"{{#if conversa.grupo}} data-abrir-modal="modal-grupo" role="button" tabindex="0" title="Participantes"{{/if}}>
          <div class="dm-cab-nome">{{#if (eq conversa.tipo "protegido")}}<span class="sig-generico">Seu protegido</span><span class="sig-real">{{conversa.titulo}}</span>{{else}}{{conversa.titulo}}{{/if}}{{#if conversa.secreto}} <span class="tag-secreto">🎭 anjo secreto</span>{{/if}}</div>
          <div class="dm-cab-sub" data-dm-sub data-rotulo="{{conversa.rotulo}}"{{#if conversa.online}} data-online="1"{{/if}}>{{#if conversa.online}}<span class="dm-ativo">ativo agora</span>{{else}}{{conversa.rotulo}}{{/if}}</div>
        </div>
        {{#if (eq conversa.tipo "protegido")}}
          <span class="sigilo-olho" data-sigilo-toggle role="button" tabindex="0" aria-label="Mostrar ou ocultar quem é" title="Mostrar/ocultar quem é">
            <svg class="olho-ver" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
            <svg class="olho-ocultar" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
          </span>
        {{/if}}
        {{#unless conversa.secreto}}{{#if conversa.usuario}}
          <button type="button" class="btn-icone dm-tema-btn" data-abrir-modal="modal-tema-chat" title="Tema da conversa" aria-label="Tema da conversa">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22a10 10 0 1 1 0-20c5.5 0 10 3.6 10 8 0 2.2-1.8 4-4 4h-2.2a1.8 1.8 0 0 0-1.3 3c.4.5.5 1 .3 1.6A2.2 2.2 0 0 1 12 22z"/><circle cx="7.5" cy="10.5" r="1.3"/><circle cx="12" cy="7.5" r="1.3"/><circle cx="16.5" cy="10.5" r="1.3"/></svg>
          </button>
          <a href="/u/{{conversa.usuario}}" class="btn btn-secundario btn-sm dm-verperfil">Ver perfil</a>
        {{/if}}{{/unless}}
        {{#if conversa.grupo}}
          <button type="button" class="btn-icone dm-grupo-btn" data-abrir-modal="modal-grupo" title="Participantes" aria-label="Participantes">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </button>
        {{/if}}
      </header>

      <div class="dm-msgs" id="dmMsgs" data-editar-url="/mensagens/editar">
        {{#if conversa.secreto}}
          {{#if (eq conversa.tipo "anjo")}}
            <div class="dm-aviso dm-aviso-secreto"><strong>Conversa anônima.</strong> Seu anjo lê e responde sem se identificar.</div>
          {{else}}
            <div class="dm-aviso dm-aviso-secreto"><strong>Modo Anjo Secreto.</strong> <span class="sig-generico">Seu protegido</span><span class="sig-real">{{conversa.titulo}}</span> recebe estas mensagens como <strong>"Seu anjo"</strong> e não sabe que é você.</div>
          {{/if}}
        {{/if}}
        {{#each conversa.mensagens}}
          {{#if this.sistema}}{{> dmSistema}}{{else}}{{> dmBolha}}{{/if}}
        {{else}}
          {{#if (eq conversa.tipo "protegido")}}
            <div class="dm-inicio">Ainda não há mensagens. Mande um oi anônimo para começar.</div>
          {{else}}{{#if (eq conversa.tipo "anjo")}}
            <div class="dm-inicio">Ainda não há mensagens. Pergunte algo — seu anjo responde sem se revelar.</div>
          {{else}}
            <div class="dm-inicio">Ainda não há mensagens. Diga olá.</div>
          {{/if}}{{/if}}
        {{/each}}
      </div>

      <button type="button" class="dm-novas" data-dm-novas hidden>↓ Novas mensagens</button>
      <form class="dm-composer" action="{{conversa.action}}" method="POST" enctype="multipart/form-data" data-resp-rotulo="{{conversa.rotuloResposta}}">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <div class="dm-prog" data-dm-prog hidden><i></i></div>
        <input type="hidden" name="responder_a" value="" data-resp-id>
        {{! Barra "Respondendo a…" (aparece ao arrastar a bolha / botão responder) }}
        <div class="dm-respondendo" data-resp-bar hidden>
          <div class="dm-respondendo-txt"><strong data-resp-autor></strong><span data-resp-trecho></span></div>
          <button type="button" class="dm-resp-x" data-resp-cancelar aria-label="Cancelar resposta">&times;</button>
        </div>
        {{! Filtro de voz em TODOS os chats. No canal do protegido o padrão é Grave
            (anonimato primeiro); nos demais, Normal — o efeito é brincadeira opcional. }}
        {{#if (eq conversa.tipo "protegido")}}
          <div class="dm-filtro" data-filtro-voz>
            <span class="dm-filtro-rot" title="O áudio é enviado já com a voz disfarçada — seu protegido não reconhece você">Voz:</span>
            <button type="button" class="dm-filtro-op sel" data-voz="grave">Grave</button>
            <button type="button" class="dm-filtro-op" data-voz="aguda">Aguda</button>
            <button type="button" class="dm-filtro-op" data-voz="robo">Robô</button>
            <button type="button" class="dm-filtro-op" data-voz="normal">Normal</button>
          </div>
        {{else}}
          <div class="dm-filtro" data-filtro-voz>
            <span class="dm-filtro-rot" title="Divirta-se: o áudio vai com a voz transformada">Voz:</span>
            <button type="button" class="dm-filtro-op sel" data-voz="normal">Normal</button>
            <button type="button" class="dm-filtro-op" data-voz="grave">Grave</button>
            <button type="button" class="dm-filtro-op" data-voz="aguda">Aguda</button>
            <button type="button" class="dm-filtro-op" data-voz="robo">Robô</button>
          </div>
        {{/if}}
        <div class="composer-anexo" data-preview hidden></div>
        <div class="dm-composer-linha" data-linha-normal>
          <div class="dm-campo">
            <textarea name="mensagem" maxlength="{{limite}}" rows="1" placeholder="{{conversa.placeholder}}" data-enter-envia data-texto>{{conversa.prefill}}</textarea>
            <button type="button" class="dm-acao dm-acao-in" data-foto-btn aria-label="Enviar foto" title="Enviar foto">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            </button>
            <button type="button" class="dm-acao dm-acao-in" data-camera aria-label="Tirar foto" title="Tirar foto">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
            </button>
          </div>
          <button type="submit" class="btn btn-primario dm-enviar" data-btn-enviar hidden aria-label="Enviar">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          </button>
          <button type="button" class="btn btn-primario dm-enviar" data-gravar aria-label="Gravar mensagem de voz" title="Gravar mensagem de voz">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
          </button>
        </div>
        <div class="dm-composer-linha dm-gravando" data-linha-gravando hidden>
          <button type="button" class="dm-acao" data-grav-cancelar aria-label="Descartar gravação" title="Descartar">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
          </button>
          <span class="dm-grav-dot" aria-hidden="true"></span>
          <span class="dm-grav-tempo" data-grav-tempo>0:00</span>
          <span class="dm-onda" aria-hidden="true"></span>
          <button type="button" class="dm-grav-pausa dm-grav-ouvir" data-grav-ouvir hidden aria-label="Ouvir o que você gravou" title="Ouvir prévia">
            <svg class="ic-prev-play" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="6 3 21 12 6 21"/></svg>
            <svg class="ic-prev-stop" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" stroke="none"><rect x="5" y="5" width="14" height="14" rx="2"/></svg>
          </button>
          <button type="button" class="dm-grav-pausa" data-grav-pausa aria-label="Pausar ou retomar gravação">
            <svg class="ic-pausa" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" stroke="none"><rect x="5" y="4" width="5" height="16" rx="1"/><rect x="14" y="4" width="5" height="16" rx="1"/></svg>
            <svg class="ic-retomar" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/></svg>
          </button>
          <button type="button" class="btn btn-primario dm-enviar" data-grav-enviar aria-label="Enviar mensagem de voz">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          </button>
        </div>
        <input type="file" name="imagem" accept="image/png,image/jpeg,image/gif,image/webp" class="visualmente-oculto" data-foto>
        <input type="file" name="audio" accept="audio/webm,audio/mp4,audio/mpeg,audio/ogg,audio/wav,audio/x-wav" capture class="visualmente-oculto" data-audio-input tabindex="-1">
        <input type="file" name="video" accept="video/webm,video/mp4,video/quicktime" class="visualmente-oculto" data-video tabindex="-1">
      </form>
    {{else}}
      <div class="direct-placeholder">
        <div class="direct-placeholder-ic">
          <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
        </div>
        <h2>Suas mensagens</h2>
        <p class="texto-suave">Escolha uma conversa ao lado para começar.{{#if semCampanha}}<br>O canal do Anjo aparece quando há uma campanha ativa.{{/if}}</p>
      </div>
    {{/if}}
  </section>
</div>

{{#if temasChat}}
{{! Tema da conversa (só DM do escritório): vale para os dois lados e troca ao vivo }}
<div class="modal sheet-share" id="modal-tema-chat" hidden aria-hidden="true">
  <div class="modal-card share-card tema-chat-card">
    <div class="sheet-cab sempre">
      <span class="sheet-grab" aria-hidden="true"></span>
      <span class="sheet-titulo">Tema da conversa</span>
      <button type="button" class="sheet-x" data-fechar-modal="modal-tema-chat" aria-label="Fechar">&times;</button>
    </div>
    <p class="texto-suave tema-chat-dica">Vale para você e para {{conversa.titulo}}. Muda na hora para os dois.</p>
    <div class="tema-chat-grade" data-tema-chat-grade data-url="/mensagens/u/{{conversa.id}}/tema">
      {{#each temasChat}}
        <button type="button" class="tema-chat-op{{#if this.ativo}} ativo{{/if}}" data-tema-chat="{{this.chave}}" title="{{this.nome}}">
          <span class="tema-chat-amostra" style="background: {{this.amostra}}"></span>
          <span class="tema-chat-nome">{{this.nome}}</span>
        </button>
      {{/each}}
    </div>
  </div>
</div>
{{/if}}

{{! Novo grupo: nome + participantes (seletor de pessoas) }}
<div class="modal sheet-share" id="modal-novo-grupo" hidden aria-hidden="true">
  <div class="modal-card share-card grupo-card">
    <div class="sheet-cab sempre">
      <span class="sheet-grab" aria-hidden="true"></span>
      <span class="sheet-titulo">Novo grupo</span>
      <button type="button" class="sheet-x" data-fechar-modal="modal-novo-grupo" aria-label="Fechar">&times;</button>
    </div>
    <label class="grupo-label" for="ng-nome">Nome do grupo</label>
    <input type="text" id="ng-nome" class="grupo-input" maxlength="60" placeholder="Ex.: Equipe cível" autocomplete="off" data-ng-nome>
    <div class="grupo-label-linha"><span class="grupo-label">Participantes</span><button type="button" class="grupo-add" data-ng-escolher>+ Escolher pessoas</button></div>
    <div class="grupo-chips" data-ng-chips></div>
    <div class="share-rodape"><button type="button" class="btn btn-primario share-enviar" data-ng-criar disabled>Criar grupo</button></div>
  </div>
</div>

{{#if conversa.grupo}}
{{! Participantes do grupo aberto: renomear, adicionar, sair }}
<div class="modal sheet-share" id="modal-grupo" hidden aria-hidden="true">
  <div class="modal-card share-card grupo-card">
    <div class="sheet-cab sempre">
      <span class="sheet-grab" aria-hidden="true"></span>
      <span class="sheet-titulo">Grupo</span>
      <button type="button" class="sheet-x" data-fechar-modal="modal-grupo" aria-label="Fechar">&times;</button>
    </div>
    {{! Foto do grupo (opcional) }}
    <div class="grupo-foto-area">
      <span class="conv-av grupo-av grupo-foto-prev" data-g-foto-prev>{{#if conversa.foto}}<img src="{{conversa.foto}}" alt="">{{else}}{{#each conversa.amostra}}<span class="grupo-av-m">{{#if this.foto}}<img src="{{this.foto}}" alt="">{{else}}{{inicial this.nome}}{{/if}}</span>{{else}}<span class="grupo-av-m">👥</span>{{/each}}{{/if}}</span>
      <div class="grupo-foto-acoes">
        <button type="button" class="grupo-add" data-g-foto-trocar>{{#if conversa.foto}}Trocar foto{{else}}Adicionar foto{{/if}}</button>
        {{#if conversa.foto}}<button type="button" class="grupo-add grupo-add-tirar" data-g-foto-remover>Remover</button>{{/if}}
      </div>
      <input type="file" accept="image/png,image/jpeg,image/webp" class="visualmente-oculto" data-g-foto-input tabindex="-1">
    </div>
    <label class="grupo-label" for="g-nome">Nome</label>
    <div class="grupo-nome-linha">
      <input type="text" id="g-nome" class="grupo-input" value="{{conversa.titulo}}" maxlength="60" autocomplete="off" data-g-nome>
      <button type="button" class="btn btn-secundario btn-sm" data-g-renomear>Salvar</button>
    </div>
    <div class="grupo-label-linha"><span class="grupo-label">{{conversa.membros.length}} participantes</span><button type="button" class="grupo-add" data-g-adicionar>+ Adicionar</button></div>
    <div class="share-lista grupo-membros">
      {{#each conversa.membros}}
        <a class="share-item" href="/u/{{this.usuario}}">
          <span class="share-av">{{#if this.foto_perfil}}<img src="{{this.foto_perfil}}" alt="">{{else}}{{inicial this.nome}}{{/if}}</span>
          <span class="share-txt"><span class="share-nome">{{this.nome}}{{#if (eq this.id_usuario @root.usuario.id_usuario)}} (você){{/if}}</span><span class="share-user">@{{this.usuario}}{{#if this.admin}} · criou o grupo{{/if}}</span></span>
          {{#if @root.conversa.souAdmin}}{{#unless (eq this.id_usuario @root.usuario.id_usuario)}}<button type="button" class="grupo-tirar" data-g-remover="{{this.id_usuario}}" data-g-nome-remover="{{this.nome}}" title="Remover do grupo" aria-label="Remover do grupo">&times;</button>{{/unless}}{{/if}}
        </a>
      {{/each}}
    </div>
    <button type="button" class="grupo-sair" data-g-sair>Sair do grupo</button>
  </div>
</div>
{{/if}}

{{! Nota (como as Notes do Instagram): texto livre até 60 caracteres, só a equipe vê, some em 24 h }}
<div class="modal sheet-share" id="modal-nota" hidden aria-hidden="true">
  <div class="modal-card share-card nota-card">
    <div class="sheet-cab sempre">
      <span class="sheet-grab" aria-hidden="true"></span>
      <span class="sheet-titulo">{{#if notaEu}}Sua nota{{else}}Nova nota{{/if}}</span>
      <button type="button" class="sheet-x" data-fechar-modal="modal-nota" aria-label="Fechar">&times;</button>
    </div>
    <form action="/conta/nota" method="POST" class="nota-form" data-nota-form>
      <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <div class="nota-previa">
        <span class="nota-previa-bolha{{#unless notaEu}} vazia{{/unless}}" data-nota-previa>{{#if notaEu}}{{notaEu}}{{else}}Compartilhe o que está pensando…{{/if}}</span>
        <span class="nota-av nota-previa-av">{{#if usuario.foto_perfil}}<img src="{{usuario.foto_perfil}}" alt="">{{else}}{{inicial usuario.nome}}{{/if}}</span>
      </div>
      <div class="nota-campo">
        <input type="text" name="nota" maxlength="60" placeholder="Compartilhe o que está pensando…" value="{{notaEu}}" autocomplete="off" autocapitalize="sentences" data-nota-input>
        <span class="nota-cont" data-nota-cont>0/60</span>
      </div>
      <div class="nota-sugestoes" data-nota-sugestoes>
        {{#each sugestoesNota}}<button type="button" class="nota-sug" data-nota-sug="{{this.emoji}} {{this.rotulo}}">{{this.emoji}} {{this.rotulo}}</button>{{/each}}
      </div>
      <p class="texto-suave nota-dica">Só a equipe vê, aqui no Direct. Some em 24 horas.</p>
      <div class="modal-acoes nota-acoes">
        {{#if notaEu}}<button type="submit" class="btn btn-secundario btn-sm" name="apagar" value="1" formnovalidate>Apagar nota</button>{{/if}}
        <button type="submit" class="btn btn-primario btn-sm" data-nota-enviar{{#unless notaEu}} disabled{{/unless}}>Compartilhar</button>
      </div>
    </form>
  </div>
</div>
