<div class="auth-form-cab">
  <span class="et">Senha provisória</span>
  <h1>Crie sua senha</h1>
  <p>A senha que você usou é provisória. Escolha uma senha só sua para continuar.</p>
</div>

{{> authErro}}

<form class="form" action="/trocar-senha" method="POST" novalidate data-auth-form="trocar">
  {{#if csrfToken}}<input type="hidden" name="_csrf" value="{{csrfToken}}">{{/if}}

  {{> authSenha id="senha" rotulo="Nova senha" auto="new-password" regra=true}}
  {{> authSenha id="confirmarSenha" rotulo="Confirmar senha" auto="new-password" tecla="done" confere=true}}

  <button type="submit" class="btn btn-primario btn-bloco" data-auth-enviar data-carregando="Salvando">Salvar senha</button>
</form>
