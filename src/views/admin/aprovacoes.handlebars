{{! Aprovações como as solicitações do Instagram: Aprovar/Recusar em cada pessoa, e a linha
    sai na hora (sem recarregar). Quando acaba a fila, aparece o "Tudo em dia". }}
<div class="adm" data-adm-sai>
  <header class="adm-cab">
    <div class="adm-cab-txt">
      <h1>Aprovações</h1>
      <small><span data-adm-n="pendentes">{{pendentes.length}}</span> aguardando · aprove só quem você reconhece</small>
    </div>
    <a class="adm-cab-btn" href="/admin/usuarios?f=recusados" aria-label="Ver cadastros recusados">
      <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="17" y1="8" x2="22" y2="13"/><line x1="22" y1="8" x2="17" y2="13"/></svg>
    </a>
  </header>

  <div class="adm-lista" data-adm-lista>
    {{#each pendentes}}{{> admUsuario}}{{/each}}
  </div>
  <div class="adm-vazio" data-adm-vazio{{#if pendentes.length}} hidden{{/if}}>
    {{#if (eq tema.chave "natal")}}<span class="adm-vazio-ic nt-globo">{{> natalGlobo}}</span>{{else}}<span class="adm-vazio-ic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>{{/if}}
    <strong>Tudo em dia</strong>
    <small>Nenhum cadastro aguardando aprovação. Quando alguém se cadastrar, aparece aqui.</small>
    <a class="adm-vazio-link" href="/admin/usuarios">Ver todos os usuários</a>
  </div>
</div>
