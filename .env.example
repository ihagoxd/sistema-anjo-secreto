# ===== Aplicação =====
NODE_ENV=development
PORT=3000
SESSION_SECRET=troque-este-segredo-em-producao
# HTTPS: cookie "secure", HSTS e upgrade-insecure-requests. Padrão segue NODE_ENV.
# Rodando em HTTP interno (LAN) mesmo com NODE_ENV=production? Use SERVIR_HTTPS=false.
# SERVIR_HTTPS=false

# ===== Banco de dados PostgreSQL =====
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=anjo_secreto
# TLS (apenas em nuvem / banco gerenciado):
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false
# DB_SSL_CA=/caminho/para/ca.pem

# ===== Segurança / autenticação =====
BCRYPT_ROUNDS=12
LOGIN_MAX_TENTATIVAS=5
# Rate limit (opcionais — têm padrões sensatos):
# RATE_LIMIT_MAX=300        # req/min por IP nas rotas dinâmicas
# RATE_LIMIT_REGISTRO=10    # cadastros/hora por IP

# ===== Admin inicial (seed: npm run db:seed) =====
# Login é por "usuario" (nome ou apelido), não por e-mail.
ADMIN_INICIAL_NOME=Administrador
ADMIN_INICIAL_USUARIO=admin
ADMIN_INICIAL_SENHA=troque@123
