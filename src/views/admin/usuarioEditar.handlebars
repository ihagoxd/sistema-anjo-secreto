{{! Editar usuário (admin), igual ao Editar perfil: "Salvar" no topo só acende quando algo muda e
    grava sem recarregar. Senha, inativar e excluir ficam em linhas embaixo, cada uma com o card
    de confirmação, e o resultado aparece na própria tela. }}
<div class="ed adm-ed" data-adm-ed data-adm-pessoa="{{alvo.id_usuario}}" data-nome="{{alvo.nome}}"{{#unless alvo.ativo}} data-inativo="1"{{/unless}}>
  <header class="ed-topo">
    <a href="/admin/usuarios" class="ed-topo-btn" data-fluido-voltar aria-label="Voltar para os usuários"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg></a>
    <h1 class="ed-titulo">Editar usuário</h1>
    <button type="submit" form="formUsuario" class="ed-salvar" data-fluido-salvar disabled>Salvar</button>
  </header>

  <div class="adm-ed-quem">
    <span class="adm-av" aria-hidden="true">{{#if alvo.foto_perfil}}<img src="{{alvo.foto_perfil}}" alt="">{{else}}{{inicial alvo.nome}}{{/if}}</span>
    <div>
      <strong data-adm-ed-nome>{{alvo.nome}}</strong>
      <small><span data-adm-ed-login>@{{alvo.usuario}}</span> · <span data-adm-ed-sit>{{#if (eq alvo.status "PENDENTE")}}Aguardando aprovação{{else if (eq alvo.status "RECUSADO")}}Recusado{{else if alvo.ativo}}Ativo{{else}}Inativo{{/if}}</span> · cadastro {{tempoRel alvo.criado_em}}</small>
    </div>
    {{#unless ehProprio}}<a class="adm-ed-perfil" href="/u/{{alvo.usuario}}" aria-label="Ver o perfil"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg></a>{{/unless}}
  </div>

  {{#if senhaResetada}}
    <div class="card senha-prov-card">
      <h3>Senha provisória de {{alvo.nome}}</h3>
      <div class="senha-prov-linha">
        <code class="senha-prov" id="senha-prov">{{senhaResetada}}</code>
        <button type="button" class="btn btn-primario btn-sm" data-copiar-texto="{{senhaResetada}}" data-copiar-aviso="Senha copiada">Copiar</button>
      </div>
      <p class="ajuda">Passe essa senha para {{alvo.nome}}. Ela só aparece aqui, agora. No próximo login, o app pede a senha definitiva.</p>
    </div>
  {{/if}}

  <form id="formUsuario" class="ed-form" action="/admin/usuarios/{{alvo.id_usuario}}/editar" method="POST" novalidate data-fluido>
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
    <div class="ed-campos">
      <label class="ed-campo com-ic">
        <span class="ed-ic" aria-hidden="true"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></span>
        <span class="ed-rot">Nome completo</span>
        <input type="text" name="nome" value="{{alvo.nome}}" required autocomplete="off" autocapitalize="words" enterkeyhint="next">
      </label>
      <label class="ed-campo com-ic">
        <span class="ed-ic" aria-hidden="true"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-3.9 7.9"/></svg></span>
        <span class="ed-rot">Usuário (login)</span>
        <input type="text" name="usuario" value="{{alvo.usuario}}" required autocomplete="off" autocapitalize="none" autocorrect="off" spellcheck="false" enterkeyhint="done" data-adm-login>
      </label>
    </div>
    <div class="adm-ed-sec">Tipo de acesso</div>
    <div class="adm-tipos adm-ed-tipos" role="radiogroup" aria-label="Tipo de acesso">
      <label class="adm-tipo">
        <input type="radio" name="tipo_usuario" value="PARTICIPANTE"{{#if (eq alvo.tipo_usuario "PARTICIPANTE")}} checked{{/if}}{{#if ehProprio}} disabled{{/if}}>
        <span class="adm-tipo-ic" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg></span>
        <span class="adm-tipo-txt"><strong>Participante</strong><small>Joga o Anjo Secreto e usa a rede</small></span>
      </label>
      <label class="adm-tipo">
        <input type="radio" name="tipo_usuario" value="ADMINISTRADOR"{{#if (eq alvo.tipo_usuario "ADMINISTRADOR")}} checked{{/if}}{{#if ehProprio}} disabled{{/if}}>
        <span class="adm-tipo-ic" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></span>
        <span class="adm-tipo-txt"><strong>Administrador</strong><small>Só gerencia, não entra no sorteio</small></span>
      </label>
      {{#if ehProprio}}
        <input type="hidden" name="tipo_usuario" value="{{alvo.tipo_usuario}}">
        <small class="ed-ajuda">Esta é a sua conta: o seu tipo de acesso só pode ser mudado por outro administrador.</small>
      {{/if}}
    </div>
  </form>

  {{#unless ehProprio}}
    <div class="adm-ed-sec">Conta</div>
    <div class="pn-lista adm-ed-acoes">
      {{#if (eq alvo.status "APROVADO")}}
        <button type="button" class="pn-linha" data-adm-ed-op="senha" id="senha-nova">
          <span class="pn-linha-ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>
          <span class="pn-linha-txt"><strong>Redefinir senha</strong><small>Gera uma senha provisória para você passar</small></span>
          <span class="pn-linha-seta"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></span>
        </button>
      {{/if}}
      {{#unless (eq alvo.status "PENDENTE")}}
        <button type="button" class="pn-linha" data-adm-ed-op="inativar"{{#unless alvo.ativo}} hidden{{/unless}}>
          <span class="pn-linha-ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="4.9" y1="4.9" x2="19.1" y2="19.1"/></svg></span>
          <span class="pn-linha-txt"><strong>Inativar acesso</strong><small>Desconecta na hora e bloqueia a entrada</small></span>
        </button>
        <button type="button" class="pn-linha" data-adm-ed-op="ativar"{{#if alvo.ativo}} hidden{{/if}}>
          <span class="pn-linha-ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
          <span class="pn-linha-txt"><strong>Reativar acesso</strong><small>A pessoa volta a conseguir entrar</small></span>
        </button>
      {{/unless}}
      <button type="button" class="pn-linha adm-ed-perigo" data-adm-ed-op="excluir">
        <span class="pn-linha-ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg></span>
        <span class="pn-linha-txt"><strong>Excluir conta</strong><small>Apaga a pessoa e tudo o que ela postou</small></span>
      </button>
    </div>
  {{/unless}}
</div>
