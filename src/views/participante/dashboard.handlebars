<div class="pagina-cabecalho">
  <div>
    <h1>Olá, {{usuario.nome}}!</h1>
    <p class="subtitulo">Bem-vindo ao Anjo Secreto.</p>
  </div>
</div>

{{#if campanhaAtiva}}
  {{#if protegido}}
    <div class="painel-hero">
      <div class="painel-hero-rot">Campanha · {{campanhaAtiva.nome}}</div>
      <div class="painel-hero-av">{{#if protegido.foto_perfil}}<img src="{{protegido.foto_perfil}}" alt="">{{else}}{{inicial protegido.nome}}{{/if}}</div>
      <p class="painel-hero-sub">Você é o anjo de</p>
      <h2 class="painel-hero-nome">{{protegido.nome}}</h2>
      <p class="painel-hero-dica">Cuide dele(a) em segredo até o fim do mês.</p>
      <a href="/participante/protegido" class="btn btn-primario">Ver o que {{protegido.nome}} gosta</a>
    </div>

    <div class="acoes-rapidas">
      <button type="button" class="acao-card acao-card-btn" data-instalar-app hidden>
        <span class="acao-ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></span>
        <div><strong>Instalar o app</strong><small>Ícone na tela inicial, abre em tela cheia</small></div>
      </button>
      {{#if tema.temPrefs}}
      <a class="acao-card acao-card-tema" href="/participante/preferencias/tema">
        <span class="acao-ic acao-ic-emoji">{{tema.emoji}}</span>
        <div><strong>{{tema.prefs.titulo}}</strong><small>{{#if temaPrefsPreenchido}}Ver ou editar minha lista de presentes{{else}}Conte o que você quer ganhar{{/if}}</small></div>
      </a>
      {{/if}}
      <a class="acao-card" href="/mensagens" >
        <span class="acao-ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg></span>
        <div><strong>Mensagens {{#if naoLidas}}<span class="badge andamento">{{naoLidas}}</span>{{/if}}</strong><small>Fale com seu anjo e protegido</small></div>
      </a>
      <a class="acao-card" href="/participante/preferencias">
        <span class="acao-ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg></span>
        <div><strong>Meu perfil</strong><small>{{#if temPreferencias}}Editar preferências{{else}}Preencha para o anjo acertar{{/if}}</small></div>
      </a>
      <a class="acao-card" href="/feed">
        <span class="acao-ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.5 12 3l9 6.5V20a1 1 0 0 1-1 1h-5.5v-6.5h-5V21H4a1 1 0 0 1-1-1z"/></svg></span>
        <div><strong>Feed</strong><small>Novidades da equipe</small></div>
      </a>
    </div>
  {{else}}
    <div class="card">
      <p style="margin:0;">A campanha <strong>{{campanhaAtiva.nome}}</strong> está em andamento,
      mas você não está participando dela. Fale com o administrador se isso estiver errado.</p>
    </div>
  {{/if}}
{{else}}
  <div class="painel-hero">
    <div class="painel-hero-av">✨</div>
    <p class="painel-hero-sub">Nenhuma campanha em andamento</p>
    <h2 class="painel-hero-nome">Aguarde o sorteio</h2>
    <p class="painel-hero-dica">Assim que o sorteio acontecer, seu protegido aparece aqui. Enquanto isso, capriche no seu perfil!</p>
    <a href="/participante/preferencias" class="btn btn-primario">Preencher meu perfil</a>
  </div>

  <div class="acoes-rapidas">
    <button type="button" class="acao-card acao-card-btn" data-instalar-app hidden>
      <span class="acao-ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></span>
      <div><strong>Instalar o app</strong><small>Ícone na tela inicial, abre em tela cheia</small></div>
    </button>
    {{#if tema.temPrefs}}
    <a class="acao-card acao-card-tema" href="/participante/preferencias/tema">
      <span class="acao-ic acao-ic-emoji">{{tema.emoji}}</span>
      <div><strong>{{tema.prefs.titulo}}</strong><small>{{#if temaPrefsPreenchido}}Ver ou editar minha lista de presentes{{else}}Conte o que você quer ganhar{{/if}}</small></div>
    </a>
    {{/if}}
    <a class="acao-card" href="/participante/preferencias">
      <span class="acao-ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg></span>
      <div><strong>Meu perfil</strong><small>{{#if temPreferencias}}Editar preferências{{else}}Preencher preferências{{/if}}</small></div>
    </a>
    <a class="acao-card" href="/feed">
      <span class="acao-ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.5 12 3l9 6.5V20a1 1 0 0 1-1 1h-5.5v-6.5h-5V21H4a1 1 0 0 1-1-1z"/></svg></span>
      <div><strong>Feed</strong><small>Novidades da equipe</small></div>
    </a>
  </div>
{{/if}}

{{#if mostrarModalPerfil}}
  <div class="modal" id="modal-perfil">
    <div class="modal-card">
      <div class="modal-cab">
        <h2>Complete seu perfil</h2>
        <p class="texto-suave">Adicione uma foto e suas preferências para o seu anjo te presentear melhor.</p>
      </div>
      <form class="form" action="/participante/perfil" method="POST" enctype="multipart/form-data" novalidate>
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        {{> perfilCampos}}
        <div class="modal-acoes">
          <button type="button" class="btn btn-secundario" data-fechar-modal>Pular por agora</button>
          <button type="submit" class="btn btn-primario">Salvar perfil</button>
        </div>
      </form>
    </div>
  </div>
{{/if}}
