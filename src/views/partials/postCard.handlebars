<article class="tw-post ig-post{{#if @root.detalhe}} tw-post-det{{/if}}{{#if this.presente_anjo}} post-presente{{/if}}" data-id="{{this.id_post}}">
  {{#if this.presente_anjo}}
    {{! Presente de Anjo: aura dourada + faixa no topo com brilho passando e estrelinhas }}
    <span class="presente-aura" aria-hidden="true"></span>
    <div class="presente-faixa" aria-label="Presente de Anjo">
      <span class="presente-faixa-brilho" aria-hidden="true"></span>
      <span class="presente-faixa-ic" aria-hidden="true">🎁</span>
      <div class="presente-faixa-txt"><strong>Presente de Anjo</strong><small>Olha o mimo que chegou ✨</small></div>
      <span class="presente-faixa-estrelas" aria-hidden="true"><i>✦</i><i>✧</i><i>✦</i></span>
    </div>
  {{/if}}
  <header class="ig-cab">
    {{#if this.presente_anjo}}<span class="presente-av-badge" aria-hidden="true">👼</span>{{/if}}
    {{#if this.temStory}}
      <button type="button" class="ig-av av-story {{#if this.storyVisto}}visto{{else}}tem{{/if}}" data-ver-stories="{{this.id_usuario}}" title="Ver o story de {{this.usuario}}">{{#if this.foto_perfil}}<img src="{{this.foto_perfil}}" alt="">{{else}}{{inicial this.nome}}{{/if}}</button>
    {{else}}
      <a href="/u/{{this.usuario}}" class="ig-av">{{#if this.foto_perfil}}<img src="{{this.foto_perfil}}" alt="" loading="lazy">{{else}}{{inicial this.nome}}{{/if}}</a>
    {{/if}}
    <div class="ig-cab-txt">
      <a href="/u/{{this.usuario}}" class="ig-user">{{this.usuario}}</a>
      {{~#if (primeiro this.colaboradores)~}}
        <span class="ig-e">e</span><a href="/u/{{primeiro this.colaboradores}}" class="ig-user">{{primeiro this.colaboradores}}</a>
        {{~#if (alemDoPrimeiro this.colaboradores)}}<span class="ig-user ig-mais-colab" title="{{juntar this.colaboradores}}">+{{alemDoPrimeiro this.colaboradores}}</span>{{/if~}}
      {{~else}}{{#if this.usuario_colab}}<span class="ig-e">e</span><a href="/u/{{this.usuario_colab}}" class="ig-user">{{this.usuario_colab}}</a>{{/if}}{{/if~}}
      <span class="ig-tempo">{{tempoRel this.criado_em}}<span class="ig-editado" data-editado{{#unless this.editado_em}} hidden{{/unless}} title="{{#if this.editado_em}}Editado em {{formatarData this.editado_em}}{{/if}}"> · editado</span></span>
      {{#if this.local}}<span class="ig-local"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>{{this.local}}</span>{{/if}}
    </div>
    {{#if (ou (eq this.id_usuario @root.usuario.id_usuario) (eq @root.usuario.tipo_usuario "ADMINISTRADOR"))}}
      <div class="tw-post-cab-acoes">
        {{#if (eq this.id_usuario @root.usuario.id_usuario)}}
          <button type="button" class="btn-icone tw-post-edit" data-editar-post="{{this.id_post}}" title="Editar texto" aria-label="Editar texto">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
          </button>
        {{/if}}
        <form action="/feed/{{this.id_post}}/remover" method="POST" class="tw-post-del" data-confirmar="Remover esta publicação?">
          <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">
          <button type="submit" class="btn-icone" title="Remover" aria-label="Remover">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
          </button>
        </form>
      </div>
    {{/if}}
  </header>

  {{#unless this.imagem}}{{#if this.texto}}<div class="tw-post-texto ig-texto{{#if this.enquete}}{{#unless this.enquete.pergunta}} enq-pergunta{{/unless}}{{/if}}"><span data-post-texto>{{comMencoes this.texto}}</span></div>{{/if}}{{/unless}}
  {{#if this.enquete}}{{> enquete this}}{{/if}}

  {{#if (alemDoPrimeiro this.midias)}}
    {{! Carrossel (várias fotos): rolagem lateral com encaixe, bolinhas, setas no desktop e contador }}
    <div class="ig-carrossel" data-carrossel>
      <div class="ig-car-track" data-car-track>
        {{#each this.midias}}<div class="ig-car-slide tw-post-midia" data-post-id="{{../id_post}}" data-img="{{this}}" role="button" tabindex="0" aria-label="Ampliar imagem (clique 2x para curtir)"><img src="{{this}}" alt="Foto" draggable="false" loading="lazy" decoding="async"></div>{{/each}}
      </div>
      <button type="button" class="ig-car-seta prev" data-car-prev aria-label="Anterior"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg></button>
      <button type="button" class="ig-car-seta next" data-car-next aria-label="Próxima"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></button>
      <span class="ig-car-cont" data-car-cont>1/{{this.midias.length}}</span>
      <div class="ig-car-dots" data-car-dots>{{#each this.midias}}<i{{#if @first}} class="on"{{/if}}></i>{{/each}}</div>
    </div>
  {{else}}{{#if this.imagem}}<div class="tw-post-midia" data-post-id="{{this.id_post}}" data-img="{{this.imagem}}" role="button" tabindex="0" aria-label="Ampliar imagem (clique 2x para curtir)">{{#if this.presente_anjo}}<span class="presente-laco" aria-hidden="true">🎁</span><span class="presente-faiscas" aria-hidden="true"><i>✦</i><i>✧</i><i>✦</i><i>✧</i></span>{{/if}}<img src="{{this.imagem}}" alt="Foto" draggable="false" loading="lazy" decoding="async"></div>{{/if}}{{/if}}
  {{#if this.video}}<div class="ig-video">{{#if this.presente_anjo}}<span class="presente-laco" aria-hidden="true">🎁</span>{{/if}}<video src="{{this.video}}" controls playsinline preload="metadata"></video></div>{{/if}}

  <div class="tw-post-acoes ig-acoes">
    <span class="ig-curtir-wrap">
      <button type="button" class="tw-acao curtir {{#if this.curtiu}}ativo{{/if}}{{#if this.minha_reacao}}{{#unless (eq this.minha_reacao "❤️")}} com-emoji{{/unless}}{{/if}}" data-curtir="{{this.id_post}}" data-reacao-minha="{{this.minha_reacao}}" aria-pressed="{{this.curtiu}}" aria-label="Curtir (segure para reagir)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        <span class="ig-reacao-minha" aria-hidden="true">{{#if this.minha_reacao}}{{#unless (eq this.minha_reacao "❤️")}}{{this.minha_reacao}}{{/unless}}{{/if}}</span>
        <span class="post-curtidas">{{abrevia this.curtidas}}</span>
      </button>
      <div class="ig-reacoes" data-reacoes hidden aria-label="Reagir">
        <button type="button" data-reacao="❤️">❤️</button><button type="button" data-reacao="😂">😂</button><button type="button" data-reacao="😮">😮</button><button type="button" data-reacao="😢">😢</button><button type="button" data-reacao="👏">👏</button><button type="button" data-reacao="🔥">🔥</button>
      </div>
    </span>
    <button type="button" class="tw-acao coment" data-comentarios="{{this.id_post}}" aria-expanded="{{#if @root.detalhe}}true{{else}}false{{/if}}" aria-label="Comentários">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8z"/></svg>
      <span class="post-coments">{{abrevia this.comentarios}}</span>
    </button>
    <button type="button" class="tw-acao repost {{#if this.repostou}}ativo{{/if}}" data-repost="{{this.id_post}}" aria-pressed="{{this.repostou}}" aria-label="Repostar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
      <span class="post-reposts">{{abrevia this.reposts}}</span>
    </button>
    <button type="button" class="tw-acao salvar{{#if this.salvei}} ativo{{/if}}" data-salvar="{{this.id_post}}" aria-pressed="{{this.salvei}}" aria-label="Salvar" title="Salvar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
    </button>
    <button type="button" class="tw-acao share" data-share="/p/{{this.id_post}}" aria-label="Compartilhar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
    </button>
  </div>

  <div class="ig-rodape">
    <div class="ig-curtidas" data-vercurtidas="{{this.id_post}}" role="button" tabindex="0" title="Ver quem curtiu"{{#unless (num this.curtidas)}} hidden{{/unless}}><span class="ig-reacoes-top" data-reacoes-top>{{#each this.reacoes_top}}<i>{{this}}</i>{{/each}}</span><span data-linha-curtidas>{{linhaCurtidas this.curtidor this.curtidas}}</span></div>

    {{#if this.imagem}}{{#if this.texto}}<div class="tw-post-texto ig-legenda"><a href="/u/{{this.usuario}}" class="ig-user">{{this.usuario}}</a><span data-post-texto>{{comMencoes this.texto}}</span></div>{{/if}}{{/if}}

    {{#unless @root.detalhe}}
      {{! Prévia dos 2 comentários mais recentes (tom suave, diferente da legenda do autor) }}
      {{#each (ultimos this.comentariosLista 2)}}
        <div class="ig-prev-coment{{#if this.imagem}} tem-foto{{/if}}" data-coment-prev="{{this.id_comentario}}"><span class="ig-prev-txt"><a href="/u/{{this.usuario}}" class="ig-user">{{this.usuario}}</a>{{comMencoes this.texto}}</span>{{#if this.imagem}}<img class="ig-prev-thumb" src="{{this.imagem}}" alt="Foto do comentário" data-img="{{this.imagem}}" role="button" tabindex="0" title="Ampliar foto" loading="lazy" draggable="false">{{/if}}</div>
      {{/each}}
      <button type="button" class="ig-vercoments" data-comentarios="{{this.id_post}}"{{#unless (num this.comentarios)}} hidden{{/unless}}>{{#if (eq (num this.comentarios) 1)}}Ver 1 comentário{{else}}Ver todos os {{num this.comentarios}} comentários{{/if}}</button>
    {{/unless}}
  </div>

  <div class="tw-comentarios-bloco" data-bloco="{{this.id_post}}"{{#unless @root.detalhe}} hidden{{/unless}}>
    <div class="sheet-cab">
      <span class="sheet-grab" aria-hidden="true"></span>
      <span class="sheet-titulo">Comentários</span>
      <button type="button" class="sheet-x" data-comentarios="{{this.id_post}}" aria-label="Fechar">&times;</button>
    </div>
    <div class="tw-comentarios">
      {{#each this.comentariosLista}}
        {{> comentario this dono=../id_usuario}}
      {{/each}}
    </div>

    <div class="sheet-emojis" aria-hidden="true">
      <button type="button" class="sheet-emoji" data-emoji-rapido>❤️</button>
      <button type="button" class="sheet-emoji" data-emoji-rapido>🙌</button>
      <button type="button" class="sheet-emoji" data-emoji-rapido>🔥</button>
      <button type="button" class="sheet-emoji" data-emoji-rapido>👏</button>
      <button type="button" class="sheet-emoji" data-emoji-rapido>😢</button>
      <button type="button" class="sheet-emoji" data-emoji-rapido>😍</button>
      <button type="button" class="sheet-emoji" data-emoji-rapido>😮</button>
      <button type="button" class="sheet-emoji" data-emoji-rapido>😂</button>
    </div>

    <form class="tw-reply" action="/feed/{{this.id_post}}/comentar" method="POST" enctype="multipart/form-data" data-reply>
      <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">
      <input type="hidden" name="responde_a" value="" data-resp-pai>
      {{! "Respondendo a @fulano" (fio) — o × volta a comentar no post }}
      <div class="tw-reply-a" data-reply-a hidden><span>Respondendo a <strong data-reply-a-quem></strong></span><button type="button" class="tw-reply-a-x" data-reply-a-x aria-label="Cancelar resposta">&times;</button></div>
      {{! Prévia da foto escolhida (aparece acima do campo; o × tira a foto) }}
      <div class="tw-reply-prev" data-reply-prev hidden>
        <span class="tw-reply-prev-item"><img src="" alt="Foto escolhida"><button type="button" class="tw-reply-prev-x" data-reply-prev-x aria-label="Remover foto" title="Remover foto">&times;</button></span>
      </div>
      <span class="tw-reply-av" aria-hidden="true">{{#if @root.usuario.foto_perfil}}<img src="{{@root.usuario.foto_perfil}}" alt="">{{else}}{{inicial @root.usuario.nome}}{{/if}}</span>
      <input type="text" name="texto" placeholder="Adicione um comentário…" maxlength="500" autocomplete="off" data-mencoes>
      <button type="button" class="tw-reply-foto" data-reply-foto aria-label="Comentar com foto" title="Comentar com foto (ou cole uma imagem com Ctrl+V)">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
      </button>
      <input type="file" name="imagem" accept="image/png,image/jpeg,image/gif,image/webp" class="visualmente-oculto" data-reply-input tabindex="-1">
      <button type="submit" class="btn btn-primario btn-sm">Enviar</button>
    </form>
  </div>
  <div class="sheet-fundo" data-comentarios="{{this.id_post}}" aria-hidden="true"></div>
</article>
