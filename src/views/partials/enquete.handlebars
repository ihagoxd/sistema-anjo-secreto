{{! Enquete do post (estilo WhatsApp). Contexto: o post (id_post + enquete). O JS re-renderiza o miolo ao votar. }}
<div class="enquete" data-enquete="{{id_post}}" data-me="{{@root.usuario.id_usuario}}">
  <div class="enq-cab">📊 {{#if enquete.multipla}}Escolha uma ou mais opções{{else}}Escolha uma opção{{/if}}</div>
  {{#each enquete.opcoes}}
    <button type="button" class="enq-opcao {{#if votei}}votei{{/if}} {{#if ../enquete.multipla}}multipla{{/if}}" data-opcao="{{id_opcao}}" style="--p: {{pct}}%" aria-pressed="{{votei}}">
      <span class="enq-barra"></span>
      <span class="enq-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
      <span class="enq-txt">{{texto}}</span>
      {{#if votantes.length}}<span class="enq-avs">{{#each (primeiros votantes 3)}}{{#if foto}}<img src="{{foto}}" alt="">{{else}}<span>{{inicial nome}}</span>{{/if}}{{/each}}</span>{{/if}}
      <span class="enq-n">{{votos}}</span>
    </button>
  {{/each}}
  <div class="enq-rodape">
    <span class="enq-total">{{#if (eq enquete.total 1)}}1 voto{{else}}{{enquete.total}} votos{{/if}}</span>
    <button type="button" data-enq-votos>Ver votos</button>
  </div>
</div>
