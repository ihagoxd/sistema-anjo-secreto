{{! Item de grupo na lista do Direct (também devolvido pronto por /mensagens/g/:id/item para entrar ao vivo) }}
<a class="conv conv-grupo{{#if this.ativa}} ativa{{/if}}{{#if this.naoLidas}} tem-novas{{/if}}" href="/mensagens/g/{{this.id_grupo}}" data-conv-g="{{this.id_grupo}}" data-busca="{{this.nome}} grupo">
  <span class="conv-av grupo-av">{{#if this.foto}}<img src="{{this.foto}}" alt="">{{else}}{{#each this.amostra}}<span class="grupo-av-m">{{#if this.foto}}<img src="{{this.foto}}" alt="">{{else}}{{inicial this.nome}}{{/if}}</span>{{else}}<span class="grupo-av-m">👥</span>{{/each}}{{/if}}</span>
  <div class="conv-txt">
    <div class="conv-nome"><span class="conv-nome-txt">{{this.nome}}</span><span class="tag-grupo">grupo</span><span class="conv-mudo" data-conv-mudo{{#unless this.silenciada}} hidden{{/unless}} title="Silenciada"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M13.7 21a2 2 0 0 1-3.4 0"/><path d="M18.6 13A17.9 17.9 0 0 1 18 8"/><path d="M6.3 6.3A5.9 5.9 0 0 0 6 8c0 7-3 9-3 9h14"/><path d="M18 8a6 6 0 0 0-9.3-5"/><line x1="1" y1="1" x2="23" y2="23"/></svg></span></div>
    <div class="conv-linha2"><span class="conv-sub">{{#if this.ultima}}{{this.ultima.texto}}{{else}}{{this.membrosN}} participantes{{/if}}</span>{{#if this.ultima}}<span class="conv-hora" data-conv-hora="{{isoData this.ultima.criado_em}}">· {{tempoCurto this.ultima.criado_em}}</span>{{/if}}</div>
  </div>
  {{#if this.naoLidas}}<span class="conv-badge">{{this.naoLidas}}</span>{{/if}}
</a>
