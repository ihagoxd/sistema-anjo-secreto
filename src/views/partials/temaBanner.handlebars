{{! Faixa do tema no topo do feed (só quando o tema tem banner). A pessoa pode esconder
    no X (fica guardado no aparelho; volta se o tema trocar). }}
{{#if tema.banner}}
{{! Quem já preencheu a lista do tema vê a faixa compacta (uma linha), para o feed aparecer antes }}
<section class="tema-banner tb-{{tema.chave}}{{#if temaPrefsPreenchido}} tb-compacta{{/if}}" data-tema-banner="{{tema.chave}}">
  <div class="tb-deco" aria-hidden="true">
    {{#if (eq tema.chave "halloween")}}
    <i class="tb-bat" style="top:16%;--d:11s"><b></b></i>
    <i class="tb-bat" style="top:8%;--d:14s;animation-delay:-6s"><b></b></i>
    <i class="tb-bat" style="top:26%;--d:12s;animation-delay:-3s"><b></b></i>
    <span class="tb-neblina"></span>
    {{else if (eq tema.chave "natal")}}
    <i class="tb-floco" style="--x:3%;--d:5.0s;--t:3px;animation-delay:-0.0s"></i>
    <i class="tb-floco" style="--x:10%;--d:6.3s;--t:4px;animation-delay:-1.7s"></i>
    <i class="tb-floco" style="--x:17%;--d:7.6s;--t:5px;animation-delay:-3.4s"></i>
    <i class="tb-floco" style="--x:24%;--d:8.9s;--t:3px;animation-delay:-5.1s"></i>
    <i class="tb-floco" style="--x:31%;--d:5.0s;--t:4px;animation-delay:-0.8s"></i>
    <i class="tb-floco" style="--x:38%;--d:6.3s;--t:5px;animation-delay:-2.5s"></i>
    <i class="tb-floco" style="--x:45%;--d:7.6s;--t:3px;animation-delay:-4.2s"></i>
    <i class="tb-floco" style="--x:52%;--d:8.9s;--t:4px;animation-delay:-5.9s"></i>
    <i class="tb-floco" style="--x:58%;--d:5.0s;--t:5px;animation-delay:-1.6s"></i>
    <i class="tb-floco" style="--x:65%;--d:6.3s;--t:3px;animation-delay:-3.3s"></i>
    <i class="tb-floco" style="--x:72%;--d:7.6s;--t:4px;animation-delay:-5.0s"></i>
    <i class="tb-floco" style="--x:79%;--d:8.9s;--t:5px;animation-delay:-0.7s"></i>
    <i class="tb-floco" style="--x:86%;--d:5.0s;--t:3px;animation-delay:-2.4s"></i>
    <i class="tb-floco" style="--x:93%;--d:6.3s;--t:4px;animation-delay:-4.1s"></i>
    {{else}}
    <span class="tb-balao" style="--c:#ff5a5f;left:3%;animation-delay:-2s"></span>
    <span class="tb-balao" style="--c:#4cc9f0;left:11%;animation-delay:-6s;transform:scale(.7)"></span>
    <span class="tb-balao" style="--c:#ffd166;left:90%;animation-delay:-4s"></span>
    <span class="tb-balao" style="--c:#06d6a0;left:96%;animation-delay:-8s;transform:scale(.75)"></span>
    <i class="tb-confete" style="--c:#8338ec;left:22%;animation-delay:-1s"></i>
    <i class="tb-confete" style="--c:#ff70a6;left:40%;animation-delay:-3s"></i>
    <i class="tb-confete" style="--c:#06d6a0;left:58%;animation-delay:-5s"></i>
    <i class="tb-confete" style="--c:#ffd166;left:76%;animation-delay:-2.5s"></i>
    <i class="tb-confete" style="--c:#4cc9f0;left:84%;animation-delay:-4.2s"></i>
    {{/if}}
  </div>
  <div class="tb-txt">
    <span class="tb-kicker">{{{tema.icone}}} {{tema.slogan}}</span>
    <h2 class="tb-tit">{{tema.banner.titulo}}</h2>
    <p class="tb-sub">{{tema.banner.texto}}</p>
    {{#if tema.temPrefs}}{{#unless (eq usuario.tipo_usuario "ADMINISTRADOR")}}
      <a class="btn btn-primario tb-btn" href="/participante/preferencias/tema">{{#if temaPrefsPreenchido}}{{tema.banner.botaoPreenchido}}{{else}}{{tema.banner.botao}}{{/if}} →</a>
    {{/unless}}{{/if}}
  </div>
  <div class="tb-arte" aria-hidden="true">{{#if (eq tema.chave "halloween")}}<span data-abobora title="Toque!">🎃</span><span>👻</span><span>🦇</span>{{else if (eq tema.chave "natal")}}<svg class="tb-vila" viewBox="0 0 170 100" preserveAspectRatio="xMaxYMax meet" data-vila><path d="M0 100 Q40 66 90 72 T170 50 V100 Z" fill="#cfe0ff" opacity="0.55"/>{{> natalPinho x=114 y=13 s=0.62 cor="#0b1a42"}}{{> natalPinho x=146 y=31 s=0.46 cor="#0b1a42"}}{{> natalCasa x=50 y=20 s=0.56 telhado="#e3304a"}}<path d="M14 100 Q56 76 106 82 T170 76 V100 Z" fill="#eef5ff"/></svg>{{else}}<span>🎁</span><span>🧸</span><span>🎈</span>{{/if}}</div>
  <button type="button" class="tb-x" data-fechar-banner="{{tema.chave}}" aria-label="Esconder esta faixa" title="Esconder">&times;</button>
</section>
{{/if}}
