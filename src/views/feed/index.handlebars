<div class="mural-layout">
  <div class="mural-centro">
    {{! Puxar para atualizar (celular): o indicador desce com o dedo e gira enquanto busca }}
    <div class="ptr" data-ptr aria-hidden="true"><span class="feed-spinner"></span></div>
    {{! Faixa do tema da rede (ex.: Mês das Crianças) — só quando o admin ativa um tema com faixa }}
    {{> temaBanner}}

    <div class="stories">
      {{! Seu story: anel dourado se você tem story ativo (clica e assiste); botão "+" publica }}
      <div class="story">
        <div class="story-ring-area">
          {{#if tenhoStory}}
            <button type="button" class="story-ring tem eu-story" data-ver-stories="{{usuario.id_usuario}}" title="Ver seu story"><span class="story-ring-in">{{#if usuario.foto_perfil}}<img src="{{usuario.foto_perfil}}" alt="">{{else}}{{inicial usuario.nome}}{{/if}}</span></button>
          {{else}}
            <button type="button" class="story-ring sem eu-story" data-add-story data-meu-id="{{usuario.id_usuario}}" title="Publicar um story"><span class="story-ring-in">{{#if usuario.foto_perfil}}<img src="{{usuario.foto_perfil}}" alt="">{{else}}{{inicial usuario.nome}}{{/if}}</span></button>
          {{/if}}
          <button type="button" class="story-badge mais" data-add-story title="Adicionar ao story" aria-label="Adicionar ao story"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></button>
        </div>
        <span class="story-nome">Seu story</span>
      </div>
      {{#each equipe}}
        {{#if this.temStory}}
          <button type="button" class="story" data-usuario-id="{{this.id_usuario}}" data-ver-stories="{{this.id_usuario}}" title="Ver o story de {{this.nome}}{{#if this.humor}} · {{rotuloHumor this.humor}}{{/if}}">
            <div class="story-ring-area">
              <span class="story-ring {{#if this.storyVisto}}visto{{else}}tem{{/if}}"><span class="story-ring-in">{{#if this.foto_perfil}}<img src="{{this.foto_perfil}}" alt="">{{else}}{{inicial this.nome}}{{/if}}</span></span>
              {{#if this.humor}}<span class="story-badge">{{emojiHumor this.humor}}</span>{{/if}}
            </div>
            <span class="story-nome">{{this.usuario}}</span>
          </button>
        {{else}}
          <a class="story" href="/u/{{this.usuario}}" data-usuario-id="{{this.id_usuario}}" title="{{this.nome}}{{#if this.humor}} · {{rotuloHumor this.humor}}{{/if}}">
            <div class="story-ring-area">
              <span class="story-ring sem"><span class="story-ring-in">{{#if this.foto_perfil}}<img src="{{this.foto_perfil}}" alt="">{{else}}{{inicial this.nome}}{{/if}}</span></span>
              {{#if this.humor}}<span class="story-badge">{{emojiHumor this.humor}}</span>{{/if}}
            </div>
            <span class="story-nome">{{this.usuario}}</span>
          </a>
        {{/if}}
      {{/each}}
    </div>

    {{! Form invisível que publica o story. O + abre DIRETO a galeria do celular
        (foto ou vídeo num seletor só, como o "Adicionar ao story" do Instagram);
        o arquivo vai intacto — qualidade original, sem recompressão. }}
    <form id="formStory" action="/stories" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <input type="file" accept="image/png,image/jpeg,image/gif,image/webp,video/webm,video/mp4,video/quicktime" class="visualmente-oculto" data-story-picker tabindex="-1">
      <input type="file" name="imagem" accept="image/png,image/jpeg,image/gif,image/webp" class="visualmente-oculto" data-foto tabindex="-1">
      <input type="file" name="video" accept="video/webm,video/mp4,video/quicktime" class="visualmente-oculto" data-video tabindex="-1">
      <button type="button" data-camera hidden tabindex="-1" aria-hidden="true"></button>
    </form>

    <form class="post-compositor card" id="form-post" action="/feed" method="POST" enctype="multipart/form-data" novalidate>
      <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <div class="compositor-topo">
        <span class="post-avatar">{{#if usuario.foto_perfil}}<img src="{{usuario.foto_perfil}}" alt="">{{else}}{{inicial usuario.nome}}{{/if}}</span>
        <textarea name="texto" maxlength="{{limite}}" placeholder="{{#if tema.placeholderPost}}{{tema.placeholderPost}}{{else}}No que você está pensando?{{/if}}" autocomplete="off" data-mencoes data-texto></textarea>
      </div>
      <div class="compositor-preview" data-preview hidden></div>
      {{! Enquete (como no WhatsApp): o texto do post é a pergunta; as opções são montadas pelo JS }}
      <div class="enquete-builder" data-enquete-builder hidden>
        <div class="enq-b-topo">
          <span class="enq-b-icone" aria-hidden="true">📊</span>
          <div class="enq-b-titulos"><strong>Criar enquete</strong><small>A equipe vota direto no feed, sem sair da tela</small></div>
          <button type="button" class="btn-icone enq-b-x" data-enquete-fechar aria-label="Remover enquete" title="Remover enquete">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
        <label class="enq-b-label" for="enq-pergunta">Pergunta</label>
        <input type="text" id="enq-pergunta" class="enq-b-pergunta" name="enquete_pergunta" maxlength="200" placeholder="Ex.: Qual o lanche da sexta?" autocomplete="off" data-enq-pergunta>
        <div class="enq-b-label-linha"><span class="enq-b-label">Opções</span><span class="enq-b-cont" data-enq-cont>0/10</span></div>
        <div class="enq-b-opcoes" data-enq-opcoes></div>
        <button type="button" class="enq-b-add" data-enq-add>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Adicionar opção
        </button>
        <label class="enq-b-switch">
          <span class="enq-b-switch-txt"><strong>Permitir várias respostas</strong><small>Cada pessoa pode marcar mais de uma opção</small></span>
          <input type="checkbox" class="pref-switch" name="enquete_multipla" value="1" data-enq-multipla>
        </label>
        <div class="enq-b-previa">
          <span class="enq-b-label">Prévia</span>
          <div class="enquete enq-previa" data-enq-previa></div>
        </div>
      </div>
      {{! Presente de Anjo ligado: avisa que o post sai em destaque }}
      <div class="presente-faixa presente-faixa-comp" data-presente-aviso hidden>
        <span class="presente-faixa-brilho" aria-hidden="true"></span>
        <span class="presente-faixa-ic" aria-hidden="true">🎁</span>
        <div class="presente-faixa-txt"><strong>Presente de Anjo</strong><small>Esse post sai em destaque, dourado — conte como foi o mimo ✨</small></div>
        <span class="presente-faixa-estrelas" aria-hidden="true"><i>✦</i><i>✧</i><i>✦</i></span>
      </div>
      {{! Localização escolhida (chip com ×) }}
      <div class="local-chip" data-local-chip hidden><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg><span data-local-nome></span><button type="button" class="colab-tirar" data-local-tirar aria-label="Remover localização">&times;</button></div>
      {{! Colaboradores (post em dupla/trio, como no Instagram) — os chips são montados pelo JS }}
      <div class="colab-chips" data-colab-chip hidden></div>
      <input type="hidden" name="colaborador" value="" data-colab-id>
      <div class="compositor-rodape">
        <div class="compositor-acoes">
          <button type="button" class="comp-acao" data-foto-btn aria-label="Foto" title="Foto (ou cole uma imagem com Ctrl+V)"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg></button>
          <button type="button" class="comp-acao comp-mais" data-abrir-modal="modal-comp-mais" aria-label="Mais opções" title="Mais opções"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg><i class="comp-mais-dot" data-comp-mais-dot hidden></i></button>
        </div>
        <input type="hidden" name="presente_anjo" value="" data-presente-input>
        <input type="file" name="imagem" accept="image/png,image/jpeg,image/gif,image/webp" class="visualmente-oculto" data-foto multiple>
        <input type="file" name="video" accept="video/webm,video/mp4,video/quicktime" class="visualmente-oculto" data-video tabindex="-1">
        <input type="hidden" name="local" value="" data-local-input>
        <button type="submit" class="btn btn-primario">Publicar</button>
      </div>
    </form>

    <div class="feed">
      {{#each posts}}
        {{> postCard}}
      {{else}}
        <div class="card card-centro"><p class="texto-suave" style="margin:0;">Nenhuma publicação ainda. Seja o primeiro a postar.</p></div>
      {{/each}}
    </div>
    {{! Rolagem infinita: quando este marcador aparece na tela, a próxima página entra sozinha }}
    <div class="feed-fim" data-feed-mais data-ultimo="{{ultimoId}}"{{#unless temMais}} data-fim="1"{{/unless}}>
      <span class="feed-spinner" aria-hidden="true"></span>
      <span class="feed-fim-txt">Você está em dia por aqui</span>
    </div>
  </div>

  <aside class="mural-lado">
    <a class="lado-eu" href="/u/{{usuario.usuario}}">
      <span class="lado-eu-av">{{#if usuario.foto_perfil}}<img src="{{usuario.foto_perfil}}" alt="">{{else}}{{inicial usuario.nome}}{{/if}}</span>
      <div class="lado-eu-txt">
        <div class="lado-eu-user">{{usuario.usuario}}</div>
        <div class="lado-eu-nome">{{usuario.nome}}</div>
      </div>
      <span class="lado-eu-editar">Ver perfil</span>
    </a>

    {{#if sugestoes.length}}
      <div class="lado-titulo">Equipe</div>
      {{#each sugestoes}}
        <a class="sug" href="/u/{{this.usuario}}">
          <span class="sug-av">{{#if this.foto_perfil}}<img src="{{this.foto_perfil}}" alt="" loading="lazy">{{else}}{{inicial this.nome}}{{/if}}</span>
          <div class="sug-txt">
            <div class="sug-nome">{{this.nome}}</div>
            <div class="sug-user">@{{this.usuario}}</div>
          </div>
          <span class="sug-ver">Ver</span>
        </a>
      {{/each}}
    {{/if}}

    <p class="lado-rodape">Anjo Secreto · {{anoAtual}}</p>
  </aside>
</div>

{{! Localização do post: usar o GPS do aparelho, escolher entre as recentes ou digitar }}
{{! Folha "Mais" do compositor: o que não cabe na barra (barra limpa, como no Instagram). Os botões têm form="form-post" para o ui.js achar o formulário }}
<div class="modal sheet-share" id="modal-comp-mais" hidden aria-hidden="true">
  <div class="modal-card share-card comp-mais-card">
    <div class="sheet-cab sempre">
      <span class="sheet-grab" aria-hidden="true"></span>
      <span class="sheet-titulo">Adicionar ao post</span>
      <button type="button" class="sheet-x" data-fechar-modal="modal-comp-mais" aria-label="Fechar">&times;</button>
    </div>
    <div class="comp-mais-lista">
      <button type="button" class="comp-mais-op" data-camera form="form-post" data-fechar-modal="modal-comp-mais">
        <span class="comp-mais-ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg></span>
        <span class="comp-mais-txt"><strong>Câmera</strong><small>Tirar uma foto agora</small></span>
      </button>
      <button type="button" class="comp-mais-op" data-local-btn form="form-post" data-fechar-modal="modal-comp-mais">
        <span class="comp-mais-ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg></span>
        <span class="comp-mais-txt"><strong>Localização</strong><small>Onde você está</small></span>
        <span class="comp-mais-on" aria-hidden="true">Ligado</span>
      </button>
      <button type="button" class="comp-mais-op" data-colab-btn form="form-post" data-fechar-modal="modal-comp-mais">
        <span class="comp-mais-ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
        <span class="comp-mais-txt"><strong>Marcar colaborador</strong><small>Post em dupla ou trio</small></span>
      </button>
      <button type="button" class="comp-mais-op" data-enquete-btn form="form-post" data-fechar-modal="modal-comp-mais">
        <span class="comp-mais-ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg></span>
        <span class="comp-mais-txt"><strong>Enquete</strong><small>A equipe vota no feed</small></span>
        <span class="comp-mais-on" aria-hidden="true">Ligado</span>
      </button>
      <button type="button" class="comp-mais-op comp-presente" data-presente-btn aria-pressed="false" form="form-post" data-fechar-modal="modal-comp-mais">
        <span class="comp-mais-ic comp-presente-ic">🎁</span>
        <span class="comp-mais-txt"><strong>Presente de Anjo</strong><small>O post sai em destaque, dourado</small></span>
        <span class="comp-mais-on" aria-hidden="true">Ligado</span>
      </button>
    </div>
  </div>
</div>
<div class="modal sheet-share" id="modal-local" hidden aria-hidden="true">
  <div class="modal-card share-card local-card">
    <div class="sheet-cab sempre">
      <span class="sheet-grab" aria-hidden="true"></span>
      <span class="sheet-titulo">Adicionar localização</span>
      <button type="button" class="sheet-x" data-fechar-modal="modal-local" aria-label="Fechar">&times;</button>
    </div>
    <button type="button" class="local-gps" data-local-gps>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/><circle cx="12" cy="12" r="8"/></svg>
      <span data-local-gps-txt>Usar minha localização</span>
    </button>
    <div class="selp-busca local-busca"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg><input type="text" class="selp-input" placeholder="Onde você está?" maxlength="120" data-local-busca autocomplete="off"></div>
    <div class="local-lista" data-local-lista></div>
  </div>
</div>

<div class="modal sheet-share" id="modal-share" hidden aria-hidden="true">
  <div class="modal-card share-card">
    <div class="sheet-cab sempre">
      <span class="sheet-grab" aria-hidden="true"></span>
      <span class="sheet-titulo">Compartilhar</span>
      <button type="button" class="sheet-x" data-fechar-modal="modal-share" aria-label="Fechar">&times;</button>
    </div>
    <div class="share-lista">
      {{#each equipe}}
        <button type="button" class="share-item" data-share-dm="{{this.id_usuario}}">
          <span class="share-av">{{#if this.foto_perfil}}<img src="{{this.foto_perfil}}" alt="">{{else}}{{inicial this.nome}}{{/if}}</span>
          <span class="share-txt">
            <span class="share-nome">{{this.nome}}</span>
            <span class="share-user">@{{this.usuario}}</span>
          </span>
          <span class="share-check" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          </span>
        </button>
      {{else}}
        <div class="texto-suave" style="padding:10px 6px;">Ninguém disponível no Direct ainda.</div>
      {{/each}}
    </div>
    <button type="button" class="share-item share-copiar" data-share-copiar>
      <span class="share-av share-av-link" aria-hidden="true">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
      </span>
      <span class="share-txt"><span class="share-nome">Copiar link</span></span>
    </button>
    <div class="share-rodape" data-share-rodape hidden>
      <button type="button" class="btn btn-primario share-enviar" data-share-enviar>Enviar</button>
    </div>
  </div>
</div>


