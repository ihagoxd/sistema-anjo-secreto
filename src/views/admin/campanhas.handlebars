<div class="pagina-cabecalho">
  <div>
    <h1>Campanhas</h1>
    <p class="subtitulo">Cada mês tem sua rodada do Anjo Secreto.</p>
  </div>
  <a href="/admin" class="btn btn-secundario btn-sm">Voltar</a>
</div>

<details class="criar" style="margin-bottom:18px;">
  <summary class="btn btn-primario">+ Nova campanha</summary>
  <form class="form card" action="/admin/campanhas" method="POST" style="margin-top:14px;" novalidate>
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
    <div class="campo">
      <label for="nome">Nome da campanha</label>
      <input type="text" id="nome" name="nome" value="{{sugestao}}" required>
      <p class="ajuda">Sugestão do mês — você pode trocar.</p>
    </div>
    <div class="campo">
      <label for="descricao">Descrição (opcional)</label>
      <textarea id="descricao" name="descricao" placeholder="Detalhes, regras, valor sugerido dos presentes…"></textarea>
    </div>
    <button type="submit" class="btn btn-primario">Criar campanha</button>
  </form>
</details>

{{> tabelaCampanhas}}
