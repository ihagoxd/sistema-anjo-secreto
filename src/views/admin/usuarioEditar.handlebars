<div class="pagina-cabecalho">
  <div>
    <h1>Editar usuário</h1>
    <p class="subtitulo">{{alvo.nome}} · {{alvo.usuario}}</p>
  </div>
  <a href="/admin/usuarios" class="btn btn-secundario btn-sm">Voltar</a>
</div>

<form class="form card" action="/admin/usuarios/{{alvo.id_usuario}}/editar" method="POST" novalidate>
  <input type="hidden" name="_csrf" value="{{csrfToken}}">

  <div class="linha-campos">
    <div class="campo">
      <label for="nome">Nome completo</label>
      <input type="text" id="nome" name="nome" value="{{alvo.nome}}" required>
    </div>
    <div class="campo">
      <label for="usuario">Usuário (login)</label>
      <input type="text" id="usuario" name="usuario" value="{{alvo.usuario}}" autocapitalize="none" spellcheck="false" required>
    </div>
  </div>

  <div class="campo">
    <label for="tipo_usuario">Tipo</label>
    <select id="tipo_usuario" name="tipo_usuario">
      <option value="PARTICIPANTE" {{#if (eq alvo.tipo_usuario "PARTICIPANTE")}}selected{{/if}}>Participante</option>
      <option value="ADMINISTRADOR" {{#if (eq alvo.tipo_usuario "ADMINISTRADOR")}}selected{{/if}}>Administrador</option>
    </select>
  </div>

  <button type="submit" class="btn btn-primario">Salvar</button>
</form>
