<div class="auth-form-cab" data-auth-cab>
  <span class="et">Novo cadastro</span>
  <h1>Criar conta</h1>
  <p>Preencha seus dados. Um administrador vai conferir e liberar seu acesso.</p>
</div>

{{> authErro}}

{{! Cadastro sem recarregar: o login sai sugerido do nome e é conferido na hora (livre/em uso),
    a senha mostra a regra e se as duas conferem, e no fim o cartão vira "Cadastro enviado". }}
<form class="form" action="/registrar" method="POST" novalidate data-auth-form="registrar">
  {{#if csrfToken}}<input type="hidden" name="_csrf" value="{{csrfToken}}">{{/if}}

  <div class="campo">
    <label for="nome">Nome completo</label>
    <div class="auth-input">
      <svg class="auth-input-ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      <input type="text" id="nome" name="nome" autocomplete="name" autocapitalize="words"
        placeholder="Nome e sobrenome" value="{{nome}}" required enterkeyhint="next" data-auth-nome>
    </div>
  </div>

  <div class="campo">
    <label for="usuario">Usuário (login)</label>
    <div class="auth-input">
      <svg class="auth-input-ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-3.9 7.9"/></svg>
      <input type="text" id="usuario" name="usuario" autocomplete="username"
        placeholder="nome.sobrenome" value="{{usuario}}" required
        autocapitalize="none" autocorrect="off" spellcheck="false" enterkeyhint="next" data-auth-login-novo>
    </div>
    <p class="auth-dica" data-auth-livre><span class="auth-dica-ic"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span><span class="auth-dica-txt">Letras, números, ponto, hífen ou _ (sem espaço)</span></p>
  </div>

  {{> authSenha id="senha" rotulo="Senha" auto="new-password" regra=true}}
  {{> authSenha id="confirmarSenha" rotulo="Confirmar senha" auto="new-password" tecla="send" confere=true}}

  <button type="submit" class="btn btn-primario btn-bloco" data-auth-enviar data-carregando="Enviando">Enviar cadastro</button>

  <p class="auth-troca">
    Já tem acesso? <a href="/login">Entrar</a>
  </p>
</form>

<div class="auth-ok" data-auth-ok hidden>
  <span class="auth-ok-ic" aria-hidden="true"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
  <h2>Cadastro enviado</h2>
  <p>Agora é só esperar um administrador liberar o seu acesso. Depois, entre com o usuário <strong data-auth-ok-login></strong>.</p>
  <a class="btn btn-primario btn-bloco" href="/login" data-auth-ok-link>Ir para o login</a>
</div>
