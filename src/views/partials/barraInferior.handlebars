<nav class="barra-inferior" aria-label="Navegação">
  {{#if (eq usuario.tipo_usuario "ADMINISTRADOR")}}
    <a href="/admin" class="bi-item {{#if (eq caminhoAtual "/admin")}}ativo{{/if}}" aria-label="Painel">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/></svg>
    </a>
    <a href="/admin/campanhas" class="bi-item {{#if (comeca caminhoAtual "/admin/campanhas")}}ativo{{/if}}" aria-label="Campanhas">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
    </a>
    <a href="/admin/usuarios" class="bi-item {{#if (comeca caminhoAtual "/admin/usuarios")}}ativo{{/if}}" aria-label="Usuários">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/></svg>
    </a>
    <a href="/admin/aprovacoes" class="bi-item {{#if (comeca caminhoAtual "/admin/aprovacoes")}}ativo{{/if}}" aria-label="Aprovações">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><polyline points="16 11 18 13 22 9"/></svg>
    </a>
    <a href="/admin/logs" class="bi-item {{#if (comeca caminhoAtual "/admin/logs")}}ativo{{/if}}" aria-label="Logs">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="16" y2="17"/></svg>
    </a>
  {{else}}
    <a href="/feed" class="bi-item {{#if (ou (comeca caminhoAtual "/feed") (comeca caminhoAtual "/u/"))}}ativo{{/if}}" aria-label="Mural">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
    </a>
    <a href="/participante" class="bi-item {{#if (eq caminhoAtual "/participante")}}ativo{{/if}}" aria-label="Meu painel">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/></svg>
    </a>
    <a href="/mensagens" class="bi-item {{#if (comeca caminhoAtual "/mensagens")}}ativo{{/if}}" aria-label="Mensagens">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
      {{#if msgNaoLidas}}<span class="bi-badge js-msg-badge">{{msgNaoLidas}}</span>{{/if}}
    </a>
    <a href="/participante/preferencias" class="bi-item {{#if (comeca caminhoAtual "/participante/preferencias")}}ativo{{/if}}" aria-label="Preferências">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
    </a>
  {{/if}}

  {{#unless (eq usuario.tipo_usuario "ADMINISTRADOR")}}
  <a href="/u/{{usuario.usuario}}" class="bi-perfil {{#if (comeca caminhoAtual "/u/")}}ativo{{/if}}" aria-label="Meu perfil">
    <span class="bi-perfil-av">{{#if usuario.foto_perfil}}<img src="{{usuario.foto_perfil}}" alt="">{{else}}{{inicial usuario.nome}}{{/if}}</span>
  </a>
  {{/unless}}
</nav>
