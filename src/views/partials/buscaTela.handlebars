<div class="busca-tela" id="buscaTela" hidden>
  <div class="busca-topo">
    <button type="button" class="btn-icone busca-voltar" data-busca-fechar aria-label="Voltar">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <div class="busca-campo">
      <svg class="busca-lupa" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="text" id="buscaInput" placeholder="Pesquisar" autocomplete="off" autocapitalize="off" spellcheck="false" maxlength="60">
      <button type="button" class="busca-limpar" data-busca-limpar-campo aria-label="Limpar" hidden>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
  </div>
  <div class="busca-corpo">
    <div class="busca-recentes-cab" hidden>
      <strong>Recentes</strong>
      <button type="button" class="busca-limpartudo" data-busca-limpar-recentes>Limpar tudo</button>
    </div>
    <div class="busca-lista"></div>
  </div>
</div>
