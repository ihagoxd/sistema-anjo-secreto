<div class="pagina-cabecalho">
  <div>
    <h1>Editar usuário</h1>
    <p class="subtitulo">{{alvo.nome}} · {{alvo.usuario}}</p>
  </div>
  <a href="/admin/usuarios" class="btn btn-secundario btn-sm">Voltar</a>
</div>

{{#if senhaResetada}}
  <div class="card senha-prov-card">
    <h3>Senha provisória de {{alvo.nome}}</h3>
    <div class="senha-prov-linha">
      <code class="senha-prov" id="senha-prov">{{senhaResetada}}</code>
      <button type="button" class="btn btn-primario btn-sm" data-copiar-texto="{{senhaResetada}}" data-copiar-aviso="Senha copiada!">Copiar</button>
    </div>
    <p class="ajuda">
      Passe essa senha para {{alvo.nome}}. Ela só aparece aqui, agora. No próximo login,
      o app obriga a pessoa a criar a senha definitiva dela antes de continuar.
    </p>
  </div>
{{/if}}

<form class="form card" action="/admin/usuarios/{{alvo.id_usuario}}/editar" method="POST" novalidate>
  <input type="hidden" name="_csrf" value="{{csrfToken}}">

  <div class="linha-campos">
    <div class="campo">
      <label for="nome">Nome completo</label>
      <input type="text" id="nome" name="nome" value="{{alvo.nome}}" required>
    </div>
    <div class="campo">
      <label for="usuario">Usuário (login)</label>
      <input type="text" id="usuario" name="usuario" value="{{alvo.usuario}}" autocapitalize="none" spellcheck="false" required>
    </div>
  </div>

  <div class="campo">
    <label for="tipo_usuario">Tipo</label>
    <select id="tipo_usuario" name="tipo_usuario">
      <option value="PARTICIPANTE" {{#if (eq alvo.tipo_usuario "PARTICIPANTE")}}selected{{/if}}>Participante</option>
      <option value="ADMINISTRADOR" {{#if (eq alvo.tipo_usuario "ADMINISTRADOR")}}selected{{/if}}>Administrador</option>
    </select>
  </div>

  <button type="submit" class="btn btn-primario">Salvar</button>
</form>

{{#unless ehProprio}}
<form class="form card" action="/admin/usuarios/{{alvo.id_usuario}}/resetar-senha" method="POST" novalidate
      data-confirmar="Redefinir a senha de {{alvo.nome}}? A senha atual deixa de valer na hora.">
  <input type="hidden" name="_csrf" value="{{csrfToken}}">
  <h3>Redefinir senha</h3>
  <p class="texto-suave">
    Para quem esqueceu a senha. Você define uma senha provisória e repassa; no próximo login
    a pessoa é obrigada a criar a senha definitiva dela.
  </p>
  <div class="campo">
    <label for="senha-nova">Senha provisória</label>
    <input type="text" id="senha-nova" name="senha" minlength="6" maxlength="72" autocomplete="off"
           autocapitalize="none" spellcheck="false" placeholder="Deixe em branco para gerar uma automática">
    <p class="ajuda">Mínimo de 6 caracteres. Se deixar em branco, o app cria uma senha curta e fácil de ditar.</p>
  </div>
  <button type="submit" class="btn btn-secundario">Redefinir senha</button>
</form>
{{/unless}}
