{{! Editar perfil (padrão Instagram), tudo sem recarregar: a foto troca na hora (recorta e
    envia), "Salvar" só acende quando algo mudou e grava por fetch. }}
<div class="ed">
  <header class="ed-topo">
    <a href="/u/{{u.usuario}}" class="ed-topo-btn" data-ed-voltar aria-label="Voltar para o perfil"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg></a>
    <h1 class="ed-titulo">Editar perfil</h1>
    <button type="submit" form="formConta" class="ed-salvar" data-ed-salvar disabled>Salvar</button>
  </header>

  <form id="formConta" class="ed-form" action="/conta" method="POST" enctype="multipart/form-data" novalidate data-ed-form>
    <input type="hidden" name="_csrf" value="{{csrfToken}}">

    <div class="ed-foto">
      <button type="button" class="ed-av" data-ed-foto aria-label="Editar foto de perfil">
        <span class="ed-av-img" id="avatarPreview">{{#if u.foto_perfil}}<img src="{{u.foto_perfil}}" alt="">{{else}}{{inicial u.nome}}{{/if}}</span>
        <span class="ed-av-cam" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg></span>
      </button>
      <button type="button" class="ed-foto-link" data-ed-foto>{{#if u.foto_perfil}}Editar foto{{else}}Adicionar foto{{/if}}</button>
      <input type="file" id="foto_perfil" name="foto_perfil" accept="image/png,image/jpeg,image/webp" class="visualmente-oculto" data-preview="avatarPreview" data-tem-foto="{{#if u.foto_perfil}}1{{/if}}">
    </div>

    <div class="ed-campos">
      <label class="ed-campo">
        <span class="ed-rot">Nome</span>
        <input type="text" id="nome" name="nome" value="{{u.nome}}" maxlength="80" minlength="2" required autocomplete="name" enterkeyhint="done" data-ed-nome>
        <small class="ed-erro" data-ed-erro-nome hidden>O nome precisa ter pelo menos 2 letras.</small>
      </label>
      <div class="ed-campo ed-campo-fixo">
        <span class="ed-rot">Nome de usuário</span>
        <span class="ed-valor">@{{u.usuario}}</span>
        <small class="ed-dica">Não pode ser alterado.</small>
      </div>
      <label class="ed-campo">
        <span class="ed-rot">Bio <span class="ed-cont" data-ed-cont>0/150</span></span>
        <textarea id="bio" name="bio" maxlength="150" rows="1" placeholder="Conte um pouco sobre você" data-ed-bio>{{u.bio}}</textarea>
      </label>
      <div class="ed-campo">
        <span class="ed-rot">Aniversário</span>
        <div class="linha-data ed-data" data-data-nasc>
          <input type="hidden" id="data_nascimento" name="data_nascimento" value="{{dataISO u.data_nascimento}}">
          <select data-dn-dia aria-label="Dia"></select>
          <select data-dn-mes aria-label="Mês"></select>
          <select data-dn-ano aria-label="Ano"></select>
        </div>
        <small class="ed-dica">No seu aniversário, o escritório inteiro comemora com você.</small>
      </div>
    </div>

    {{#if ehParticipante}}
      <a class="ed-linha" href="/participante/preferencias">
        <span class="ed-linha-ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg></span>
        <span class="ed-linha-txt"><strong>Preferências do Anjo</strong><small>Seus gostos, para quem tirou você acertar no presente</small></span>
        <span class="ed-linha-seta"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></span>
      </a>
    {{/if}}
  </form>
</div>

{{! Folha da foto (como no Instagram): nova foto ou remover a atual }}
<div class="modal sheet-share" id="modal-ed-foto" hidden aria-hidden="true">
  <div class="modal-card share-card comp-mais-card">
    <div class="sheet-cab sempre">
      <span class="sheet-grab" aria-hidden="true"></span>
      <span class="sheet-titulo">Foto de perfil</span>
      <button type="button" class="sheet-x" data-fechar-modal="modal-ed-foto" aria-label="Fechar">&times;</button>
    </div>
    <div class="comp-mais-lista">
      <button type="button" class="comp-mais-op" data-ed-foto-nova>
        <span class="comp-mais-ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg></span>
        <span class="comp-mais-txt"><strong>Nova foto de perfil</strong><small>Da galeria ou da câmera</small></span>
      </button>
      <button type="button" class="comp-mais-op comp-mais-sair" data-ed-foto-remover>
        <span class="comp-mais-ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg></span>
        <span class="comp-mais-txt"><strong>Remover foto atual</strong><small>Volta para a inicial do seu nome</small></span>
      </button>
    </div>
  </div>
</div>

{{! Sair com alterações não salvas }}
<div class="modal" id="modal-ed-descartar" hidden aria-hidden="true">
  <div class="modal-card conf-card">
    <h3 class="conf-titulo">Descartar alterações?</h3>
    <p class="texto-suave conf-sub">O que você mudou ainda não foi salvo.</p>
    <div class="modal-acoes">
      <button type="button" class="btn btn-secundario btn-sm" data-fechar-modal="modal-ed-descartar">Continuar editando</button>
      <button type="button" class="btn btn-primario btn-sm conf-perigo" data-ed-descartar>Descartar</button>
    </div>
  </div>
</div>
