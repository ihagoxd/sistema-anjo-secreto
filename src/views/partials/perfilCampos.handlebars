<div class="perfil-topo">
  <label class="avatar-editor" for="foto_perfil" title="Escolher foto">
    <span class="avatar-editor-img" id="avatarPreview">
      {{#if usuario.foto_perfil}}
        <img src="{{usuario.foto_perfil}}" alt="Foto de perfil">
      {{else}}
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      {{/if}}
    </span>
    <span class="avatar-editor-cam" aria-hidden="true">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
    </span>
  </label>
  <input type="file" id="foto_perfil" name="foto_perfil" accept="image/png,image/jpeg,image/gif,image/webp" class="visualmente-oculto" data-preview="avatarPreview">
  <div class="perfil-nome">{{usuario.nome}}</div>
  <div class="perfil-user">@{{usuario.usuario}}</div>
  <span class="perfil-troca-dica">Toque na foto para trocar</span>
</div>

<div class="campo">
  <label for="bio">Bio</label>
  <input type="text" id="bio" name="bio" value="{{bio}}" maxlength="200" placeholder="Uma frase sobre você">
</div>

<div class="campo">
  <label for="data_nascimento"><span class="lbl-ic"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-8a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8"/><path d="M4 16s.5-1 2-1 2.5 2 4 2 2.5-2 4-2 2.5 2 4 2 2-1 2-1"/><path d="M2 21h20"/><path d="M7 8v3"/><path d="M12 8v3"/><path d="M17 8v3"/><path d="M7 4h.01"/><path d="M12 4h.01"/><path d="M17 4h.01"/></svg></span> Data de nascimento</label>
  <div class="linha-data" data-data-nasc>
    <input type="hidden" id="data_nascimento" name="data_nascimento" value="{{dataISO dataNascimento}}">
    <select data-dn-dia aria-label="Dia"></select>
    <select data-dn-mes aria-label="Mês"></select>
    <select data-dn-ano aria-label="Ano"></select>
  </div>
  <small class="ajuda">No seu aniversário, o escritório inteiro comemora com você.</small>
</div>

<div class="pf-secao">
  <div class="pf-secao-cab"><span class="pf-secao-ic"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3zm0 0v7"/></svg></span> Gostos & sabores</div>
  <p class="pf-secao-dica">Quanto mais você contar, mais fácil o seu anjo acertar.</p>

  <div class="linha-campos">
    <div class="campo">
      <label for="lanche_favorito"><span class="lbl-ic"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11h18"/><path d="M4 11a8 8 0 0 1 16 0"/><path d="M5 15h14l-1 4H6z"/></svg></span> Lanche favorito</label>
      <input type="text" id="lanche_favorito" name="lanche_favorito" value="{{prefs.lanche_favorito}}" placeholder="Ex.: Coxinha, pipoca…">
    </div>
    <div class="campo">
      <label for="bebida_favorita"><span class="lbl-ic"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8h12l-1.5 13h-9z"/><path d="M5 8h14"/><path d="M13 8l2-6h3"/></svg></span> Bebida favorita</label>
      <input type="text" id="bebida_favorita" name="bebida_favorita" value="{{prefs.bebida_favorita}}" placeholder="Ex.: Guaraná, café…">
    </div>
    <div class="campo">
      <label for="chocolate_favorito"><span class="lbl-ic"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="2"/><line x1="12" y1="3" x2="12" y2="21"/><line x1="5" y1="9" x2="19" y2="9"/><line x1="5" y1="15" x2="19" y2="15"/></svg></span> Chocolate favorito</label>
      <input type="text" id="chocolate_favorito" name="chocolate_favorito" value="{{prefs.chocolate_favorito}}" placeholder="Ex.: Kit Kat, Lacta…">
    </div>
  </div>

  <div class="campo">
    <label for="coisas_que_gosta"><span class="lbl-ic"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8z"/></svg></span> Coisas que gosta</label>
    <textarea id="coisas_que_gosta" name="coisas_que_gosta" rows="2" placeholder="Cores, marcas, personagens, estilos…">{{prefs.coisas_que_gosta}}</textarea>
  </div>
  <div class="campo">
    <label for="hobbies"><span class="lbl-ic"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="12" rx="4"/><line x1="7" y1="11" x2="7" y2="15"/><line x1="5" y1="13" x2="9" y2="13"/><circle cx="15.5" cy="12" r="1"/><circle cx="18" cy="14.5" r="1"/></svg></span> Hobbies</label>
    <textarea id="hobbies" name="hobbies" rows="2" placeholder="O que você curte fazer no tempo livre?">{{prefs.hobbies}}</textarea>
  </div>
</div>

<div class="pf-secao">
  <div class="pf-secao-cab"><span class="pf-secao-ic"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg></span> Pra acertar no presente</div>

  <div class="linha-campos-2">
    <div class="campo">
      <label for="coisas_que_nao_gosta"><span class="lbl-ic"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="4.9" y1="4.9" x2="19.1" y2="19.1"/></svg></span> Coisas que não gosta</label>
      <textarea id="coisas_que_nao_gosta" name="coisas_que_nao_gosta" rows="2" placeholder="Pra evitar na hora do presente">{{prefs.coisas_que_nao_gosta}}</textarea>
    </div>
    <div class="campo">
      <label for="restricoes_alimentares"><span class="lbl-ic"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></span> Restrições alimentares</label>
      <textarea id="restricoes_alimentares" name="restricoes_alimentares" rows="2" placeholder="Alergias, intolerâncias, dieta…">{{prefs.restricoes_alimentares}}</textarea>
    </div>
  </div>
  <div class="campo">
    <label for="observacoes"><span class="lbl-ic"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="13" y2="17"/></svg></span> Observações</label>
    <textarea id="observacoes" name="observacoes" rows="2" placeholder="Qualquer dica extra pro seu anjo">{{prefs.observacoes}}</textarea>
  </div>
</div>

<div class="pf-secao">
  <div class="pf-secao-cab"><span class="pf-secao-ic"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg></span> Fotos de ideias</div>
  <p class="pf-secao-dica">Suba fotos do que você curte — seu anjo vê essas fotos. Até {{maxFotos}} no total.</p>
  <div class="galeria-editor" id="galeriaPreview">
    <label class="galeria-add" for="fotos" title="Adicionar fotos">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    </label>
  </div>
  <input type="file" id="fotos" name="fotos" accept="image/png,image/jpeg,image/gif,image/webp" multiple class="visualmente-oculto" data-galeria="galeriaPreview">
</div>
