{{! Conteúdo da aba do perfil (Publicações / Reposts / Gostos / Salvos). A página inclui este partial e,
    ao trocar de aba, o ui.js busca só ele por fetch (JSON { html }) — sem recarregar a página. }}
  {{#if (eq aba "gostos")}}
    {{#if gostosTema.length}}<div class="tw-gostos-tema">{{> gostosTema nome=alvo.nome}}</div>{{/if}}
    {{#if (ou gostos.length fotosGosta.length)}}
      <div class="tw-gostos">
        <div class="tw-gostos-intro">O que faz {{alvo.nome}} feliz</div>
        {{#each gostos}}
          <div class="tw-gosto">
            {{#if this.icone}}<span class="tw-gosto-ic" aria-hidden="true">{{{this.icone}}}</span>{{else}}<span class="tw-gosto-emoji">{{this.emoji}}</span>{{/if}}
            <div class="tw-gosto-txt">
              <div class="tw-gosto-rotulo">{{this.rotulo}}</div>
              <div class="tw-gosto-valor">{{this.valor}}</div>
            </div>
          </div>
        {{/each}}
        {{#if fotosGosta.length}}
          <div class="tw-fotos-tit">Fotos de ideias</div>
          {{> galeriaGosta fotos=fotosGosta}}
        {{/if}}
      </div>
    {{else}}{{#unless gostosTema.length}}
      <div class="tw-vazio">
        {{#if (eq alvo.id_usuario usuario.id_usuario)}}
          <span class="pf-vazio-ic"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg></span>
          <div class="tw-vazio-tit">Conte o que você gosta</div>
          <p>Preencha suas preferências pra galera acertar no seu presente.</p>
          <a href="/participante/preferencias" class="btn btn-primario btn-sm">Preencher preferências</a>
        {{else}}
          <span class="pf-vazio-ic"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg></span>
          <div class="tw-vazio-tit">Ainda é um mistério</div>
          <p>{{alvo.nome}} ainda não contou o que gosta.</p>
        {{/if}}
      </div>
    {{/unless}}{{/if}}

  {{else if (eq aba "salvos")}}
    {{#if posts.length}}
      <div class="feed feed-perfil">
        {{#each posts}}{{> postCard}}{{/each}}
      </div>
    {{else}}
      <div class="tw-vazio">
        <span class="pf-vazio-ic"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg></span>
        <div class="tw-vazio-tit">Nada salvo ainda</div>
        <p>Toque no marcador de uma publicação para guardar aqui. Só você vê.</p>
      </div>
    {{/if}}

  {{else if (eq aba "reposts")}}
    {{#if posts.length}}
      <div class="feed feed-perfil">
        {{#each posts}}{{> postCard}}{{/each}}
      </div>
    {{else}}
      <div class="tw-vazio">
        <span class="pf-vazio-ic"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg></span>
        <div class="tw-vazio-tit">Nenhum repost ainda</div>
        {{#if (eq alvo.id_usuario usuario.id_usuario)}}
          <p>Ao repostar uma publicação, ela aparece aqui.</p>
        {{else}}
          <p>{{alvo.nome}} ainda não repostou nada.</p>
        {{/if}}
      </div>
    {{/if}}

  {{else}}
    {{#if posts.length}}
      <div class="feed feed-perfil">
        {{#each posts}}{{> postCard}}{{/each}}
      </div>
    {{else}}
      <div class="tw-vazio">
        {{#if (eq alvo.id_usuario usuario.id_usuario)}}
          <span class="pf-vazio-ic"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg></span>
          <div class="tw-vazio-tit">Você ainda não publicou nada</div>
          <p>Quando você compartilhar algo no feed, aparece aqui no seu perfil.</p>
          <a href="/feed" class="btn btn-primario btn-sm">Publicar no feed</a>
        {{else}}
          <span class="pf-vazio-ic"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg></span>
          <div class="tw-vazio-tit">Nada por aqui ainda</div>
          <p>{{alvo.nome}} ainda não publicou nada.</p>
        {{/if}}
      </div>
    {{/if}}
  {{/if}}
